# Copia questo file in .env.local e incolla i due valori che trovi su
# Supabase, in Project Settings.
#
# VITE_SUPABASE_URL      e' l'indirizzo del progetto, Project Settings > API
#                        (oppure il pulsante "Connect" in alto).
#
# VITE_SUPABASE_ANON_KEY e' la chiave PUBBLICA. A seconda di quando e' nato il
#                        progetto si chiama "anon public" (comincia per eyJ...)
#                        oppure "publishable key" (comincia per sb_publishable_).
#                        Vanno bene tutte e due: il nome della variabile qui
#                        resta lo stesso.
#
# E' pubblica per progetto, puo' stare nel browser: i permessi veri li impongono
# le policy RLS create da supabase/installazione.sql. La chiave "service_role"
# (o "secret") invece non va MAI messa qui.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

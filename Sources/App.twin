'
' App - punto di ingresso del progetto.
'
' Impostare questo modulo come Startup Object del progetto twinBASIC.
' Main esegue prima tutte le suite di test, poi emette una fattura di
' esempio: un solo avvio dice sia se il nucleo fiscale e' sano sia che
' numeri produce.
'
' Niente qui tocca l'archivio Access, e nemmeno il registratore
' telematico. Il motore di calcolo, lo scadenzario, l'aritmetica monetaria
' e la costruzione dell'XML della stampante fiscale non hanno bisogno di
' niente per funzionare, ed e' per questo che si possono provare in mezzo
' secondo a ogni modifica.
'
Module App

    Public Sub Main()
        Dim runner As TestRunner
        Set runner = New TestRunner

        ConsoleOut.WriteHeading "Gestionale - suite di test"
        StringUtilsTests.RunAll runner
        MoneyTests.RunAll runner
        CalcoloDocumentoTests.RunAll runner
        CalcoloScadenzeTests.RunAll runner
        ScontrinoTests.RunAll runner
        RtEpsonXmlTests.RunAll runner
        runner.Report

        ConsoleOut.WriteLine
        FatturaDiEsempio
        ConsoleOut.WriteLine
        ScontrinoDiEsempio
    End Sub

    ' Una fattura come se ne emettono: righe scontate, una voce esclusa
    ' art. 15 che fa scattare il bollo, spese di incasso e pagamento RiBa a
    ' 30 giorni fine mese.
    Private Sub FatturaDiEsempio()
        Dim calc As CalcoloDocumento
        Dim riga As RigaCalcolo
        Dim voce As RiepilogoIva
        Dim rate As Collection
        Dim scadenza As Scadenza
        Dim dataDocumento As Date

        dataDocumento = DateSerial(2026, 3, 18)

        Set calc = New CalcoloDocumento
        calc.BolloAddebitato = True
        calc.SpeseIncasso = 3@
        calc.PercentualeIvaSpese = 22

        Set riga = calc.AggiungiArticolo("TAST-MEC", "Tastiera meccanica", 10, 45@, 22)
        riga.UnitaMisura = "NR"
        riga.Sconto1 = 10

        Set riga = calc.AggiungiArticolo("MON-24", "Monitor 24 pollici", 2, 189@, 22)
        riga.UnitaMisura = "NR"

        Set riga = calc.AggiungiArticolo("SERV-INST", "Installazione e configurazione", 1, 150@, 22)
        riga.UnitaMisura = "ORE"

        Set riga = calc.AggiungiArticolo("RIMB-TRAS", "Rimborso spese di trasferta", 1, 80@, 0, "N1")
        riga.RiferimentoNormativo = "Operazione esclusa ex art. 15 DPR 633/72"

        calc.Calcola

        ConsoleOut.WriteHeading "Fattura di esempio del " & Format$(dataDocumento, "dd/mm/yyyy")

        For Each riga In calc.Righe
            ConsoleOut.WriteLine StringUtils.PadRight(riga.Codice, 12) & _
                                 StringUtils.PadRight(Left$(riga.Descrizione, 32), 34) & _
                                 StringUtils.PadLeft(Money.FormatAmount(CCur(riga.Quantita)), 9) & _
                                 StringUtils.PadLeft(Money.FormatAmount(riga.PrezzoNetto), 11) & _
                                 StringUtils.PadLeft(Money.FormatAmount(riga.Imponibile), 12)
        Next riga

        ConsoleOut.WriteLine
        ConsoleOut.WriteLine "Riepilogo IVA"
        For Each voce In calc.Riepilogo
            ConsoleOut.WriteLine "  " & _
                                 StringUtils.PadRight(DescrizioneAliquota(voce), 34) & _
                                 StringUtils.PadLeft(Money.FormatAmount(voce.Imponibile), 12) & _
                                 StringUtils.PadLeft(Money.FormatAmount(voce.Imposta), 12)
        Next voce

        ConsoleOut.WriteLine
        ConsoleOut.WriteField "Totale merce", Money.FormatAmount(calc.TotaleMerce)
        ConsoleOut.WriteField "Sconti", Money.FormatAmount(calc.TotaleSconti)
        ConsoleOut.WriteField "Totale imponibile", Money.FormatAmount(calc.TotaleImponibile)
        ConsoleOut.WriteField "Totale imposta", Money.FormatAmount(calc.TotaleImposta)
        ConsoleOut.WriteField "Bollo", Money.FormatAmount(calc.Bollo)
        ConsoleOut.WriteField "Totale documento", Money.FormatAmount(calc.TotaleDocumento)
        ConsoleOut.WriteField "Netto a pagare", Money.FormatAmount(calc.TotaleDaPagare)

        ConsoleOut.WriteLine
        ConsoleOut.WriteLine "Scadenze - RiBa 30 giorni fine mese"
        Set rate = CalcoloScadenze.Genera(dataDocumento, calc.TotaleDaPagare, 1, 30, 0, True, 0, "MP12")
        For Each scadenza In rate
            ConsoleOut.WriteLine "  " & scadenza.Descrizione()
        Next scadenza

        ConsoleOut.WriteLine
        MostraRilievi calc
    End Sub

    Private Sub MostraRilievi(ByVal calc As CalcoloDocumento)
        Dim problemi As Collection
        Dim problema As Variant

        Set problemi = calc.Validazione()
        If problemi.Count = 0 Then
            ConsoleOut.WriteLine "Validazione: nessun rilievo, il documento e' emettibile."
            Exit Sub
        End If

        ConsoleOut.WriteLine "Validazione: " & CStr(problemi.Count) & " rilievi"
        For Each problema In problemi
            ConsoleOut.WriteLine "  - " & CStr(problema)
        Next problema
    End Sub

    ' Uno scontrino da negozio misto: alimentari al 4 per cento, vino al
    ' 22, un paio di scarpe scontato, pagamento con bancomat piu' contanti.
    ' Mostra le tre cose che una fattura non ha.
    Private Sub ScontrinoDiEsempio()
        Dim sc As Scontrino
        Dim riga As RigaCalcolo
        Dim voce As RiepilogoIva
        Dim pagamento As PagamentoScontrino
        Dim xml As String

        Set sc = New Scontrino
        sc.AggiungiArticolo "PANE-CAS", "Pane casereccio", 1, 3.5@, 4, 4
        sc.AggiungiArticolo "VINO-ROS", "Vino rosso Montepulciano", 2, 6@, 22, 1
        ' lo sconto del dieci per cento si scarica subito sul prezzo
        ' unitario: 89,90 diventa 80,91, non 80,910
        sc.AggiungiArticolo "SCARPA-42", "Scarpa pelle nera 42", 1, 89.9@, 22, 1, 10
        sc.AggiungiPagamento Costanti.PAG_ELETTRONICO, "Bancomat", 90@
        sc.PagaInContanti 10@
        sc.Calcola

        ConsoleOut.WriteHeading "Cassa - scontrino di esempio"

        For Each riga In sc.Righe
            ConsoleOut.WriteLine StringUtils.PadRight(riga.Codice, 12) & _
                                 StringUtils.PadRight(Left$(riga.Descrizione, 30), 32) & _
                                 StringUtils.PadLeft(Money.FormatAmount(CCur(riga.Quantita), 3), 9) & _
                                 StringUtils.PadLeft(Money.FormatAmount(riga.PrezzoUnitario), 11) & _
                                 StringUtils.PadLeft(Money.FormatAmount(riga.Lordo), 12)
        Next riga

        ConsoleOut.WriteLine
        ConsoleOut.WriteLine "Riepilogo IVA"
        For Each voce In sc.Riepilogo
            ConsoleOut.WriteLine "  " & _
                                 StringUtils.PadRight(DescrizioneAliquota(voce), 24) & _
                                 StringUtils.PadLeft(Money.FormatAmount(voce.Imponibile), 12) & _
                                 StringUtils.PadLeft(Money.FormatAmount(voce.Imposta), 12) & _
                                 StringUtils.PadLeft(Money.FormatAmount(voce.Lordo), 12)
        Next voce

        ConsoleOut.WriteLine
        ConsoleOut.WriteField "Totale imponibile", Money.FormatAmount(sc.TotaleImponibile)
        ConsoleOut.WriteField "Totale imposta", Money.FormatAmount(sc.TotaleImposta)
        ConsoleOut.WriteField "Totale scontrino", Money.FormatAmount(sc.Totale)
        For Each pagamento In sc.Pagamenti
            ConsoleOut.WriteField pagamento.Descrizione, Money.FormatAmount(pagamento.Importo)
        Next pagamento
        ConsoleOut.WriteField "Pagato", Money.FormatAmount(sc.TotalePagato)
        ConsoleOut.WriteField "Resto", Money.FormatAmount(sc.Resto)

        ConsoleOut.WriteLine
        MostraRilieviScontrino sc

        ' L'XML che andrebbe alla stampante fiscale. Non serve nessun
        ' registratore collegato per costruirlo, ed e' il motivo per cui
        ' RtEpsonXml e' un modulo di funzioni pure.
        xml = RtEpsonXml.DocumentoCommerciale(sc)
        ConsoleOut.WriteLine
        ConsoleOut.WriteField "XML per il registratore", CStr(Len(xml)) & " caratteri"
        ConsoleOut.WriteField "Righe di vendita", CStr(StringUtils.CountOccurrences(xml, "<printRecItem "))
        ConsoleOut.WriteField "Totali di pagamento", CStr(StringUtils.CountOccurrences(xml, "<printRecTotal"))
        ConsoleOut.WriteField "Separatore decimale", IIf(StringUtils.Contains(xml, ","), "VIRGOLA, errore", "punto, corretto")
    End Sub

    Private Sub MostraRilieviScontrino(ByVal sc As Scontrino)
        Dim problemi As Collection
        Dim problema As Variant

        Set problemi = sc.Validazione()
        If problemi.Count = 0 Then
            ConsoleOut.WriteLine "Validazione: nessun rilievo, lo scontrino si puo' battere."
            Exit Sub
        End If

        ConsoleOut.WriteLine "Validazione: " & CStr(problemi.Count) & " rilievi"
        For Each problema In problemi
            ConsoleOut.WriteLine "  - " & CStr(problema)
        Next problema
    End Sub

    Private Function DescrizioneAliquota(ByVal voce As RiepilogoIva) As String
        If Len(voce.NaturaIva) > 0 Then
            Return "Natura " & voce.NaturaIva & " - senza imposta"
        End If
        Return "IVA " & Money.FormatAmount(CCur(voce.PercentualeIva), 0) & " per cento"
    End Function

End Module

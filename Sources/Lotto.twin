'
' Lotto - generazione e lettura del codice di lotto.
'
' Il lotto serve a ritrovare tutto quello che e' stato prodotto in una certa
' giornata, quindi deve essere leggibile anche a mano e deve poter essere
' riletto: se un cliente riporta una confezione, dal codice si deve risalire
' alla data e al turno senza consultare nessun archivio.
'
' Due formati, entrambi reversibili:
'
'   lfCompatto   L261105-03   prefisso, anno/mese/giorno, progressivo
'   lfGiuliano   L26309-03    prefisso, anno, giorno dell'anno, progressivo
'
' Il formato giuliano occupa due caratteri in meno e si incontra spesso nel
' settore alimentare; quello compatto si legge a occhio senza fare conti.
'
' Il progressivo distingue piu' lavorazioni nello stesso giorno: la prima
' preparazione del mattino e' la 1, quella del pomeriggio la 2, e cosi' via.
'
Module Lotto

    Public Enum FormatoLotto
        lfCompatto = 0
        lfGiuliano = 1
    End Enum

    Public Const PREFISSO_PREDEFINITO As String = "L"
    Public Const PROGRESSIVO_MASSIMO As Long = 99

    ' ------------------------------------------------------------------
    ' Generazione
    ' ------------------------------------------------------------------

    Public Function Genera(ByVal dataProduzione As Date, _
                           Optional ByVal progressivo As Long = 1, _
                           Optional ByVal prefisso As String = PREFISSO_PREDEFINITO, _
                           Optional ByVal formato As FormatoLotto = lfCompatto) As String
        If progressivo < 1 Or progressivo > PROGRESSIVO_MASSIMO Then
            Err.Raise 5, "Lotto.Genera", _
                      "progressivo deve essere compreso fra 1 e " & CStr(PROGRESSIVO_MASSIMO)
        End If

        Select Case formato
            Case lfCompatto
                Return UCase$(prefisso) & DateUtil.FormattaAaMmGg(dataProduzione) & _
                       "-" & DateUtil.DueCifre(progressivo)

            Case lfGiuliano
                Return UCase$(prefisso) & _
                       DateUtil.DueCifre(Year(dataProduzione) Mod 100) & _
                       TreCifre(DateUtil.GiornoDellAnno(dataProduzione)) & _
                       "-" & DateUtil.DueCifre(progressivo)

            Case Else
                Err.Raise 5, "Lotto.Genera", "formato non riconosciuto"
        End Select
    End Function

    ' ------------------------------------------------------------------
    ' Lettura
    ' ------------------------------------------------------------------

    ' Legge un codice di lotto e ricava la data di produzione e il
    ' progressivo. Restituisce Falso se il codice non ha una forma valida,
    ' senza sollevare errori: questa funzione serve anche a controllare
    ' quello che l'operatore digita a mano.
    '
    ' Il secolo viene ricostruito sul 2000: un lotto alimentare non attraversa
    ' i cento anni.
    Public Function Interpreta(ByVal codice As String, _
                               ByRef dataProduzione As Date, _
                               ByRef progressivo As Long, _
                               ByRef formato As FormatoLotto) As Boolean
        Dim corpo As String
        Dim parti() As String
        Dim cifre As String
        Dim anno As Long
        Dim mese As Long
        Dim giorno As Long
        Dim giornoAnno As Long

        codice = Trim$(UCase$(codice))
        If Len(codice) = 0 Then Return False

        ' Via il prefisso alfabetico iniziale, qualunque esso sia.
        corpo = codice
        Do While Len(corpo) > 0
            If Not EUnaCifra(Left$(corpo, 1)) Then
                corpo = Mid$(corpo, 2)
            Else
                Exit Do
            End If
        Loop

        parti = Split(corpo, "-")
        If UBound(parti) <> 1 Then Return False

        cifre = parti(0)
        If Not SoloCifre(cifre) Then Return False
        If Not SoloCifre(parti(1)) Then Return False

        progressivo = CLng(parti(1))
        If progressivo < 1 Or progressivo > PROGRESSIVO_MASSIMO Then Return False

        Select Case Len(cifre)
            Case 6      ' aammgg
                anno = 2000 + CLng(Left$(cifre, 2))
                mese = CLng(Mid$(cifre, 3, 2))
                giorno = CLng(Mid$(cifre, 5, 2))
                If mese < 1 Or mese > 12 Then Return False
                If giorno < 1 Or giorno > GiorniDelMese(anno, mese) Then Return False
                dataProduzione = DateSerial(anno, mese, giorno)
                formato = lfCompatto
                Return True

            Case 5      ' aaggg
                anno = 2000 + CLng(Left$(cifre, 2))
                giornoAnno = CLng(Mid$(cifre, 3, 3))
                If giornoAnno < 1 Or giornoAnno > GiorniDellAnno(anno) Then Return False
                dataProduzione = DateSerial(anno, 1, 1) + (giornoAnno - 1)
                formato = lfGiuliano
                Return True

            Case Else
                Return False
        End Select
    End Function

    ' Vero se il codice e' leggibile da Interpreta. Comoda per validare un
    ' campo di immissione senza dichiarare tre variabili di appoggio.
    Public Function EValido(ByVal codice As String) As Boolean
        Dim data As Date
        Dim progressivo As Long
        Dim formato As FormatoLotto
        Return Interpreta(codice, data, progressivo, formato)
    End Function

    ' ------------------------------------------------------------------
    ' Helper privati
    ' ------------------------------------------------------------------

    Private Function TreCifre(ByVal n As Long) As String
        Return Right$("00" & CStr(n), 3)
    End Function

    Private Function EUnaCifra(ByVal ch As String) As Boolean
        If Len(ch) = 0 Then Return False
        Return (ch >= "0" And ch <= "9")
    End Function

    Private Function SoloCifre(ByVal testo As String) As Boolean
        Dim i As Long

        If Len(testo) = 0 Then Return False
        For i = 1 To Len(testo)
            If Not EUnaCifra(Mid$(testo, i, 1)) Then Return False
        Next i
        Return True
    End Function

    Private Function GiorniDellAnno(ByVal anno As Long) As Long
        Return DateDiff("d", DateSerial(anno, 1, 1), DateSerial(anno + 1, 1, 1))
    End Function

    Private Function GiorniDelMese(ByVal anno As Long, ByVal mese As Long) As Long
        Return Day(DateSerial(anno, mese + 1, 1) - 1)
    End Function

End Module

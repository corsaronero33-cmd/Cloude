'
' AnteprimaTesto - l'etichetta disegnata a caratteri.
'
' Serve a due cose concrete. La prima e' vedere l'etichetta senza avere un
' form, una stampante o Windows: basta la finestra Debug. La seconda e'
' poterla provare con i test, perche' il risultato e' una stringa e una
' stringa si confronta, mentre un disegno su una PictureBox no.
'
' La griglia di caratteri e' proporzionata: ogni cella e' larga un
' millimetro circa e alta poco piu' del doppio, che e' la forma di un
' carattere in una finestra di console. Le proporzioni dell'etichetta vera si
' riconoscono, le misure esatte no: e' un'anteprima, non una prova di stampa.
'
Module AnteprimaTesto

    ' Rapporto fra altezza e larghezza di un carattere di console.
    Private Const PROPORZIONE_CELLA As Double = 2.1

    ' Rende il layout come blocco di testo, cornice compresa.
    ' Novanta colonne perche' una cella sia larga circa 0,8 mm: e' la
    ' larghezza di un carattere da 4,5 punti, il corpo piu' piccolo che
    ' l'etichetta usa. Con meno colonne le righe in corpo minore verrebbero
    ' tagliate dall'anteprima anche quando sull'etichetta vera ci stanno.
    Public Function Rendi(ByVal layout As LayoutEtichetta, _
                          Optional ByVal colonne As Long = 90) As String
        Dim griglia() As String
        Dim righe As Long
        Dim larghezzaCella As Double
        Dim altezzaCella As Double
        Dim i As Long
        Dim risultato As String

        If layout Is Nothing Then
            Err.Raise 5, "AnteprimaTesto.Rendi", "layout non puo' essere Nothing"
        End If
        If colonne < 20 Then
            Err.Raise 5, "AnteprimaTesto.Rendi", "colonne deve essere almeno 20"
        End If

        larghezzaCella = layout.LarghezzaMm / colonne
        altezzaCella = larghezzaCella * PROPORZIONE_CELLA
        righe = Int(layout.AltezzaMm / altezzaCella + 0.999)
        If righe < 1 Then righe = 1

        ReDim griglia(0 To righe - 1)
        For i = 0 To righe - 1
            griglia(i) = String$(colonne, " ")
        Next i

        DisegnaElementi layout, griglia, colonne, righe, larghezzaCella, altezzaCella

        ' Cornice: il bordo dell'etichetta fisica.
        risultato = "+" & String$(colonne, "-") & "+" & vbCrLf
        For i = 0 To righe - 1
            risultato = risultato & "|" & griglia(i) & "|" & vbCrLf
        Next i
        risultato = risultato & "+" & String$(colonne, "-") & "+"

        Return risultato
    End Function

    ' L'anteprima piu' il riepilogo delle misure e degli avvisi: e' quello
    ' che conviene mostrare all'operatore prima di stampare.
    Public Function RendiConRiepilogo(ByVal layout As LayoutEtichetta, _
                                      Optional ByVal colonne As Long = 90) As String
        Dim risultato As String

        risultato = Rendi(layout, colonne) & vbCrLf
        risultato = risultato & "Supporto " & Numero.Formatta(layout.LarghezzaMm, 0) & _
                    " x " & Numero.Formatta(layout.AltezzaMm, 0) & " mm, " & _
                    "contenuto alto " & Numero.Formatta(layout.AltezzaUsataMm(), 1) & " mm, " & _
                    CStr(layout.Conteggio) & " elementi."

        If Not layout.CiSta() Then
            risultato = risultato & vbCrLf & "ATTENZIONE: esce di " & _
                        Numero.Formatta(layout.Sforamento(), 1) & " mm."
        End If

        If layout.NumeroAvvisi > 0 Then
            risultato = risultato & vbCrLf & layout.TestoAvvisi()
        End If

        Return risultato
    End Function

    ' ------------------------------------------------------------------
    ' Disegno sulla griglia
    ' ------------------------------------------------------------------

    Private Sub DisegnaElementi(ByVal layout As LayoutEtichetta, ByRef griglia() As String, _
                                ByVal colonne As Long, ByVal righe As Long, _
                                ByVal larghezzaCella As Double, ByVal altezzaCella As Double)
        Dim i As Long
        Dim e As ElementoEtichetta

        For i = 1 To layout.Conteggio
            Set e = layout.Elemento(i)

            Select Case e.Tipo
                Case Grafica.teTesto
                    DisegnaTesto griglia, colonne, righe, larghezzaCella, altezzaCella, e

                Case Grafica.teLinea
                    Scrivi griglia, colonne, righe, _
                           Int(e.YMm / altezzaCella), Int(e.XMm / larghezzaCella), _
                           String$(Larghezza(e.LarghezzaMm, larghezzaCella), "-")

                Case Grafica.teRettangolo
                    Scrivi griglia, colonne, righe, _
                           Int(e.YMm / altezzaCella), Int(e.XMm / larghezzaCella), _
                           String$(Larghezza(e.LarghezzaMm, larghezzaCella), "-")

                Case Grafica.teBarcode
                    DisegnaBarcode griglia, colonne, righe, larghezzaCella, altezzaCella, e
            End Select
        Next i
    End Sub

    Private Sub DisegnaTesto(ByRef griglia() As String, ByVal colonne As Long, _
                             ByVal righe As Long, ByVal larghezzaCella As Double, _
                             ByVal altezzaCella As Double, ByVal e As ElementoEtichetta)
        Dim celleTesto As Long
        Dim celleCampo As Long
        Dim colonna As Long

        If Len(e.Testo) = 0 Then Exit Sub

        ' In anteprima un carattere della griglia vale un carattere del
        ' testo: e' il motivo per cui un corpo piccolo appare piu' grande
        ' del vero. Le posizioni e l'ordine delle righe sono invece esatti.
        celleTesto = Len(e.Testo)
        celleCampo = Larghezza(e.LarghezzaMm, larghezzaCella)
        colonna = Int(e.XMm / larghezzaCella)

        Select Case e.Allinea
            Case Grafica.alCentro
                colonna = colonna + (celleCampo - celleTesto) \ 2
            Case Grafica.alDestra
                colonna = colonna + celleCampo - celleTesto
        End Select

        If colonna < 0 Then colonna = 0

        Scrivi griglia, colonne, righe, Int(e.YMm / altezzaCella), colonna, e.Testo
    End Sub

    ' Ogni cella guarda il proprio punto centrale: se cade dentro una barra
    ' diventa un cancelletto, altrimenti resta vuota. A questa scala molti
    ' moduli finiscono nella stessa cella, quindi il motivo e' indicativo;
    ' serve a vedere che il codice c'e', dove sta e quanto e' largo.
    Private Sub DisegnaBarcode(ByRef griglia() As String, ByVal colonne As Long, _
                               ByVal righe As Long, ByVal larghezzaCella As Double, _
                               ByVal altezzaCella As Double, ByVal e As ElementoEtichetta)
        Dim primaRiga As Long
        Dim ultimaRiga As Long
        Dim riga As Long
        Dim primaColonna As Long
        Dim celle As Long
        Dim c As Long
        Dim offsetMm As Double
        Dim disegno As String

        ' Il codice si ferma una riga di caratteri prima del proprio bordo
        ' inferiore. Una riga della griglia e' alta quasi due millimetri,
        ' mentre la scritta leggibile sotto le barre ne e' alta meno di due:
        ' le due cose cadrebbero nella stessa riga e le barre coprirebbero
        ' la scritta. E' una concessione alla griglia, non al layout vero,
        ' dove il codice e la scritta sono uno sopra l'altra senza toccarsi.
        primaRiga = Int(e.YMm / altezzaCella)
        ultimaRiga = Int((e.YMm + e.AltezzaMm) / altezzaCella) - 1
        If ultimaRiga < primaRiga Then ultimaRiga = primaRiga

        primaColonna = Int(e.XMm / larghezzaCella)
        celle = Larghezza(e.LarghezzaMm, larghezzaCella)

        For c = 0 To celle - 1
            offsetMm = (c + 0.5) * larghezzaCella
            If EBarra(e.ElementiBarcode, e.ModuloMm, offsetMm) Then
                disegno = disegno & "#"
            Else
                disegno = disegno & " "
            End If
        Next c

        For riga = primaRiga To ultimaRiga
            Scrivi griglia, colonne, righe, riga, primaColonna, disegno
        Next riga
    End Sub

    ' Vero se il punto a offsetMm dall'inizio del codice cade su una barra.
    ' Gli elementi si alternano a partire da una barra, quindi basta sapere
    ' in quale elemento cade il punto e guardarne la parita'.
    Private Function EBarra(ByVal elementi As String, ByVal moduloMm As Double, _
                            ByVal offsetMm As Double) As Boolean
        Dim i As Long
        Dim x As Double
        Dim larghezza As Double

        If moduloMm <= 0 Then Return False

        For i = 1 To Len(elementi)
            larghezza = CLng(Mid$(elementi, i, 1)) * moduloMm
            If offsetMm >= x And offsetMm < x + larghezza Then
                Return ((i Mod 2) = 1)
            End If
            x += larghezza
        Next i

        Return False
    End Function

    ' ------------------------------------------------------------------
    ' Helper privati
    ' ------------------------------------------------------------------

    Private Function Larghezza(ByVal millimetri As Double, ByVal larghezzaCella As Double) As Long
        Dim celle As Long

        celle = Int(millimetri / larghezzaCella + 0.5)
        If celle < 1 Then celle = 1
        Return celle
    End Function

    ' Sovrascrive la griglia a partire da riga e colonna, tagliando quello
    ' che esce dai bordi.
    Private Sub Scrivi(ByRef griglia() As String, ByVal colonne As Long, ByVal righe As Long, _
                       ByVal riga As Long, ByVal colonna As Long, ByVal testo As String)
        Dim disponibili As Long

        If riga < 0 Or riga > righe - 1 Then Exit Sub
        If colonna < 0 Then
            If Len(testo) <= -colonna Then Exit Sub
            testo = Mid$(testo, -colonna + 1)
            colonna = 0
        End If
        If colonna > colonne - 1 Then Exit Sub

        disponibili = colonne - colonna
        If Len(testo) > disponibili Then testo = Left$(testo, disponibili)
        If Len(testo) = 0 Then Exit Sub

        Mid$(griglia(riga), colonna + 1, Len(testo)) = testo
    End Sub

End Module

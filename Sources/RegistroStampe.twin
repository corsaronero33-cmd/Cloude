'
' RegistroStampe - il registro di quello che e' stato stampato.
'
' Non e' un vezzo: se arriva una contestazione o un controllo, la domanda e'
' sempre la stessa, "cosa avete confezionato il giorno tale e con che lotto".
' Il registro risponde. E' un CSV in sola aggiunta, una riga per stampa, che
' si apre con Excel e si archivia.
'
' Le righe vengono accodate al file una per volta invece di riscrivere tutto:
' con qualche migliaio di etichette al mese il file cresce e riscriverlo
' sarebbe lento, e un'interruzione di corrente a meta' scrittura perderebbe
' il registro intero invece dell'ultima riga.
'
Class RegistroStampe

    Private Const COLONNE As String = _
        "DataOraStampa;Codice;Denominazione;Lotto;DataProduzione;DataScadenza;" & _
        "Copie;PesoGrammi;PrezzoEuro;Operatore"

    Public Percorso As String

    ' ------------------------------------------------------------------
    ' Scrittura
    ' ------------------------------------------------------------------

    ' Registra una stampa. Il numero di copie viene preso dall'etichetta.
    ' Restituisce la riga scritta, utile per mostrarla o per i test.
    Public Function Registra(ByVal etichetta As Etichetta, _
                             Optional ByVal operatore As String = "", _
                             Optional ByVal istante As Variant) As String
        Dim riga As String

        If Len(Trim$(Percorso)) = 0 Then
            Err.Raise 5, "RegistroStampe.Registra", _
                      "impostare Percorso prima di registrare"
        End If

        If IsMissing(istante) Then
            riga = RigaDa(etichetta, operatore, Now)
        Else
            riga = RigaDa(etichetta, operatore, CDate(istante))
        End If

        AssicuraIntestazione
        Utf8File.Accoda Percorso, riga & vbCrLf
        Return riga
    End Function

    ' Compone la riga del registro. E' separata da Registra e non tocca il
    ' disco, quindi i test la possono verificare senza scrivere file.
    Public Function RigaDa(ByVal etichetta As Etichetta, ByVal operatore As String, _
                           ByVal istante As Date) As String
        Dim campi(0 To 9) As String
        Dim scheda As Prodotto

        If etichetta Is Nothing Then
            Err.Raise 5, "RegistroStampe.RigaDa", "etichetta non puo' essere Nothing"
        End If

        Set scheda = etichetta.Scheda

        campi(0) = DateUtil.FormattaDataOra(istante)
        campi(1) = scheda.Codice
        campi(2) = scheda.Denominazione
        campi(3) = etichetta.CodiceLotto()
        campi(4) = DateUtil.FormattaDataOra(etichetta.DataOraProduzione)
        campi(5) = DateUtil.FormattaDataOra(etichetta.Scadenza())
        campi(6) = CStr(etichetta.Copie)
        campi(7) = Numero.Formatta(etichetta.PesoGrammi(), 1)
        campi(8) = Numero.Formatta(etichetta.PrezzoEuro(), 2)
        campi(9) = operatore

        Return CsvUtil.ComponiRiga(campi)
    End Function

    Public Function Intestazione() As String
        Return COLONNE
    End Function

    ' Crea il file con la sola intestazione se non esiste ancora.
    Public Sub AssicuraIntestazione()
        If Utf8File.Esiste(Percorso) Then Exit Sub
        Utf8File.Scrivi Percorso, COLONNE & vbCrLf
    End Sub

    ' ------------------------------------------------------------------
    ' Lettura
    ' ------------------------------------------------------------------

    Public Function TestoCompleto() As String
        If Not Utf8File.Esiste(Percorso) Then Return ""
        Return Utf8File.Leggi(Percorso)
    End Function

    ' Quante stampe sono registrate, intestazione esclusa.
    Public Function NumeroRegistrazioni() As Long
        Dim righe() As String
        Dim quante As Long

        righe = CsvUtil.SpezzaRighe(TestoCompleto())

        On Error Resume Next
        quante = UBound(righe) - LBound(righe) + 1
        If Err.Number <> 0 Then
            Err.Clear
            Return 0
        End If
        On Error GoTo 0

        If quante <= 1 Then Return 0        ' solo l'intestazione
        Return quante - 1
    End Function

    ' Quante copie sono state stampate in una giornata, sommando le
    ' registrazioni di quel giorno. Serve al riepilogo di fine turno.
    Public Function CopieDelGiorno(ByVal giorno As Date) As Long
        Dim righe() As String
        Dim campi() As String
        Dim i As Long
        Dim primaRiga As Long
        Dim totale As Long
        Dim atteso As String

        righe = CsvUtil.SpezzaRighe(TestoCompleto())

        On Error Resume Next
        primaRiga = LBound(righe)
        If Err.Number <> 0 Then
            Err.Clear
            Return 0
        End If
        On Error GoTo 0

        If InStr(1, righe(primaRiga), "DataOraStampa", vbTextCompare) = 1 Then
            primaRiga += 1
        End If

        atteso = DateUtil.FormattaData(giorno)

        For i = primaRiga To UBound(righe)
            campi = CsvUtil.SpezzaRiga(righe(i))
            ' La data e ora di stampa comincia con la data: basta il prefisso.
            If Left$(CsvUtil.Campo(campi, 0), Len(atteso)) = atteso Then
                totale += CLng(Numero.Interpreta(CsvUtil.Campo(campi, 6, "0")))
            End If
        Next i

        Return totale
    End Function

End Class

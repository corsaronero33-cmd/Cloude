'
' ScontrinoTests - suite di test per la vendita al banco.
'
' Il test che vale piu' degli altri e' quello di quadratura: in negozio si
' digita il prezzo di scaffale, il gestionale scorpora l'IVA per aliquota,
' e la somma degli imponibili piu' le imposte deve tornare esattamente al
' prezzo di scaffale. Se non torna, il cliente vede un totale diverso da
' quello che ha letto sull'etichetta.
'
Module ScontrinoTests

    Public Sub RunAll(ByVal runner As TestRunner)
        TestVenditaSemplice runner
        TestQuadraturaScorporo runner
        TestPagamentiMisti runner
        TestResto runner
        TestScontoDiRiga runner
        TestReparti runner
        TestReso runner
        TestValidazione runner
        TestContratto runner
    End Sub

    ' ------------------------------------------------------------------

    Private Sub TestVenditaSemplice(ByVal runner As TestRunner)
        Dim sc As Scontrino

        Set sc = New Scontrino
        sc.AggiungiArticolo "PANE", "Pane casereccio", 1, 3.5@, 4, 4
        sc.AggiungiArticolo "VINO", "Vino rosso", 2, 6@, 22, 1
        sc.PagaInContanti 20@
        sc.Calcola

        runner.BeginTest "Spesa da 15.50 pagata con venti euro"
        ' 3.50 al 4 per cento piu' 12.00 al 22 per cento
        runner.AreEqual 13.21@, sc.TotaleImponibile
        runner.AreEqual 2.29@, sc.TotaleImposta
        runner.AreEqual 15.5@, sc.Totale
        runner.AreEqual 20@, sc.TotalePagato
        runner.AreEqual 4.5@, sc.Resto
        runner.AreEqual 0@, sc.Residuo
        runner.IsTrue sc.Saldato
        runner.AreEqual 2, sc.Riepilogo.Count
    End Sub

    Private Sub TestQuadraturaScorporo(ByVal runner As TestRunner)
        Dim sc As Scontrino
        Dim voce As RiepilogoIva
        Dim somma As Variant

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Al ventidue", 1, 12.2@, 22, 1
        sc.AggiungiArticolo "B", "Al dieci", 1, 11@, 10, 2
        sc.AggiungiArticolo "C", "Al quattro", 1, 10.4@, 4, 3
        sc.PagaInContanti 33.6@
        sc.Calcola

        runner.BeginTest "Lo scorporo per aliquota torna al prezzo di scaffale"
        runner.AreEqual 3, sc.Riepilogo.Count
        runner.AreEqual 30@, sc.TotaleImponibile
        runner.AreEqual 3.6@, sc.TotaleImposta
        runner.AreEqual 33.6@, sc.Totale
        runner.AreEqual 0@, sc.Resto

        runner.BeginTest "Ogni rigo di riepilogo torna da solo"
        somma = CDec(0)
        For Each voce In sc.Riepilogo
            somma = somma + Money.Dec(voce.Imponibile) + Money.Dec(voce.Imposta)
        Next voce
        runner.AreEqual 33.6@, Money.Amount(somma)

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Prezzo dispari", 3, 0.99@, 22, 1
        sc.PagaInContanti 3@
        sc.Calcola

        runner.BeginTest "Tre pezzi da 99 centesimi fanno 2.97"
        ' E' il caso che costringe a ricavare l'imposta per differenza.
        ' Scorporando si ottiene 2.43 di imponibile, e 2.43 al 22 per cento
        ' fa 0.53: sommati, 2.96. Nessuna coppia di valori arrotondati
        ' somma a 2.97, quindi l'imposta e' 2.97 meno 2.43.
        runner.AreEqual 2.43@, sc.TotaleImponibile
        runner.AreEqual 0.54@, sc.TotaleImposta
        runner.AreEqual 2.97@, sc.Totale
        runner.AreEqual 0.03@, sc.Resto
    End Sub

    Private Sub TestPagamentiMisti(ByVal runner As TestRunner)
        Dim sc As Scontrino

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 100@, 22, 1
        sc.AggiungiPagamento Costanti.PAG_ELETTRONICO, "Bancomat", 70@
        sc.PagaInContanti 30@
        sc.Calcola

        runner.BeginTest "Settanta col bancomat e trenta in contanti"
        runner.AreEqual 100@, sc.Totale
        runner.AreEqual 100@, sc.TotalePagato
        runner.AreEqual 0@, sc.Resto
        runner.AreEqual 0@, sc.Residuo
        runner.IsTrue sc.Saldato
        runner.AreEqual 2, sc.Pagamenti.Count

        runner.BeginTest "I totali per macro-categoria stanno separati"
        runner.AreEqual 70@, sc.TotalePerTipo(Costanti.PAG_ELETTRONICO)
        runner.AreEqual 30@, sc.TotalePerTipo(Costanti.PAG_CONTANTI)
        runner.AreEqual 0@, sc.TotalePerTipo(Costanti.PAG_BUONOPASTO)

        runner.BeginTest "Nessun rilievo su una vendita saldata"
        runner.AreEqual 0, QuantiRilievi(sc)

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Pranzo", 1, 12@, 10, 2
        sc.AggiungiPagamento Costanti.PAG_BUONOPASTO, "Buono pasto", 8@
        sc.PagaInContanti 4@
        sc.Calcola

        runner.BeginTest "Buono pasto piu' differenza in contanti"
        runner.AreEqual 12@, sc.TotalePagato
        runner.AreEqual 0@, sc.Resto
        runner.AreEqual 0, QuantiRilievi(sc)
    End Sub

    Private Sub TestResto(ByVal runner As TestRunner)
        Dim sc As Scontrino

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 100@, 22, 1
        sc.PagaInContanti 50@
        sc.Calcola

        runner.BeginTest "Pagamento insufficiente lascia un residuo"
        runner.AreEqual 50@, sc.Residuo
        runner.AreEqual 0@, sc.Resto
        runner.IsFalse sc.Saldato

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 20@, 22, 1
        sc.AggiungiPagamento Costanti.PAG_ELETTRONICO, "Bancomat", 50@
        sc.Calcola

        runner.BeginTest "Il resto non puo' uscire da un bancomat"
        runner.AreEqual 30@, sc.Resto
        runner.AreEqual 1, QuantiRilievi(sc)

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 20@, 22, 1
        sc.AggiungiPagamento Costanti.PAG_ELETTRONICO, "Bancomat", 15@
        sc.PagaInContanti 10@
        sc.Calcola

        runner.BeginTest "Con contanti a copertura il resto e' regolare"
        runner.AreEqual 5@, sc.Resto
        runner.AreEqual 0, QuantiRilievi(sc)
    End Sub

    Private Sub TestScontoDiRiga(ByVal runner As TestRunner)
        Dim sc As Scontrino
        Dim riga As RigaCalcolo

        Set sc = New Scontrino
        Set riga = sc.AggiungiArticolo("A", "Articolo scontato", 3, 9.99@, 22, 1, 10)
        sc.PagaInContanti 30@
        sc.Calcola

        runner.BeginTest "Lo sconto si arrotonda subito sul prezzo unitario"
        ' il registratore ricalcola quantita' per prezzo unitario: se qui
        ' restasse 8.991 i due conti divergerebbero di un centesimo
        runner.AreEqual 8.99@, riga.PrezzoUnitario
        runner.AreEqual 9.99@, riga.PrezzoListino
        runner.AreEqual 10, riga.ScontoApplicatoPerc
        runner.AreEqual 26.97@, sc.Totale
        runner.AreEqual 3.03@, sc.Resto

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 50@, 22, 1
        sc.ScontaRiga 1, 5@
        sc.PagaInContanti 45@
        sc.Calcola

        runner.BeginTest "Lo sconto a valore si sottrae dal totale di riga"
        runner.AreEqual 45@, sc.Totale
        runner.AreEqual 0@, sc.Resto
    End Sub

    Private Sub TestReparti(ByVal runner As TestRunner)
        Dim sc As Scontrino
        Dim esplicito As RigaCalcolo
        Dim implicito As RigaCalcolo

        Set sc = New Scontrino
        sc.RepartoPredefinito = 2
        Set esplicito = sc.AggiungiArticolo("A", "Con reparto", 1, 10@, 22, 1)
        Set implicito = sc.AggiungiArticolo("B", "Senza reparto", 1, 10@, 10)
        sc.PagaInContanti 20@
        sc.Calcola

        runner.BeginTest "Il reparto indicato vince su quello predefinito"
        runner.AreEqual 1, esplicito.Reparto
        runner.AreEqual 2, implicito.Reparto

        Set sc = New Scontrino
        sc.RepartoPredefinito = 0
        sc.AggiungiArticolo "A", "Senza reparto", 1, 10@, 22
        sc.PagaInContanti 10@
        sc.Calcola

        runner.BeginTest "Una riga senza reparto e' un rilievo"
        runner.AreEqual 1, QuantiRilievi(sc)
    End Sub

    Private Sub TestReso(ByVal runner As TestRunner)
        Dim sc As Scontrino

        Set sc = New Scontrino
        sc.TipoVendita = Costanti.VENDITA_RESO
        sc.AggiungiArticolo "A", "Articolo reso", 1, 30@, 22, 1
        sc.PagaInContanti 30@
        sc.Calcola

        runner.BeginTest "Un reso si compila con importi positivi e verso negativo"
        runner.AreEqual 30@, sc.Totale
        runner.AreEqual -1, sc.SegnoContabile

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 30@, 22, 1
        sc.PagaInContanti 30@
        sc.Calcola

        runner.BeginTest "Una vendita normale ha verso positivo"
        runner.AreEqual 1, sc.SegnoContabile
    End Sub

    Private Sub TestValidazione(ByVal runner As TestRunner)
        Dim sc As Scontrino

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 10@, 22, 1
        sc.Calcola

        runner.BeginTest "Senza pagamenti ci sono due rilievi"
        ' manca il pagamento e resta un residuo
        runner.AreEqual 2, QuantiRilievi(sc)

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 10@, 22, 1
        sc.AggiungiPagamento Costanti.PAG_CONTANTI, "Contanti", 0@
        sc.Calcola

        runner.BeginTest "Un pagamento a zero e' un rilievo"
        runner.IsTrue (QuantiRilievi(sc) >= 1)

        Set sc = New Scontrino
        sc.PagaInContanti 10@
        sc.Calcola

        runner.BeginTest "Una vendita senza righe non si batte"
        runner.IsTrue (QuantiRilievi(sc) >= 1)

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 10@, 0, 1
        sc.PagaInContanti 10@

        runner.BeginTest "Aliquota zero senza natura resta un rilievo anche in cassa"
        runner.IsTrue (QuantiRilievi(sc) >= 1)
    End Sub

    Private Sub TestContratto(ByVal runner As TestRunner)
        Dim sc As Scontrino

        Set sc = New Scontrino
        sc.AggiungiArticolo "A", "Articolo", 1, 10@, 22, 1
        sc.PagaInContanti 10@

        runner.BeginTest "Leggere il resto senza avere calcolato e' un errore"
        runner.RaisedError 5, ErroreDaResto(sc)
    End Sub

    ' ------------------------------------------------------------------
    ' Helper
    ' ------------------------------------------------------------------

    Private Function QuantiRilievi(ByVal sc As Scontrino) As Long
        Dim problemi As Collection

        Set problemi = sc.Validazione()
        Return problemi.Count
    End Function

    Private Function ErroreDaResto(ByVal sc As Scontrino) As Long
        Dim resto As Currency

        On Error Resume Next
        Err.Clear
        resto = sc.Resto
        Return Err.Number
    End Function

End Module

'
' Stampa - manda un'etichetta alla stampante.
'
' La stampante arriva come Object, non come Printer: cosi' questo modulo
' compila anche dove l'oggetto Printer si chiama o si comporta in modo
' diverso, e soprattutto si puo' provare passando una PictureBox o un
' oggetto finto. Chi chiama scrive una riga sola:
'
'     Stampa.Etichette Printer, etichetta
'
' Ogni copia e' una pagina a se'. Su una stampante termica per etichette una
' pagina e' un'etichetta, quindi dieci copie sono dieci etichette; su un
' foglio A4 conviene invece Griglia, che ne mette piu' di una per pagina.
'
Module Stampa

    ' Stampa l'etichetta nel numero di copie indicato da etichetta.Copie.
    ' Restituisce quante copie ha mandato in stampa.
    Public Function Etichette(ByVal stampante As Object, ByVal etichetta As Etichetta) As Long
        Dim layout As LayoutEtichetta
        Dim copia As Long
        Dim problema As String

        ControllaArgomenti stampante, etichetta

        problema = etichetta.Valida()
        If Len(problema) > 0 Then
            Err.Raise 5, "Stampa.Etichette", "etichetta non stampabile: " & problema
        End If

        ' Il layout si compone una volta sola: le copie sono identiche e
        ' ricomporlo per ognuna sarebbe lavoro buttato.
        Set layout = ComposizioneEtichetta.Componi(etichetta)

        For copia = 1 To etichetta.Copie
            Disegno.Disegna stampante, layout
            If copia < etichetta.Copie Then NuovaPagina stampante
        Next copia

        ChiudiDocumento stampante
        Return etichetta.Copie
    End Function

    ' Stampa le copie disponendole a griglia su fogli piu' grandi, tipico
    ' dei fogli adesivi A4. I passi sono la distanza fra gli angoli in alto a
    ' sinistra di due etichette vicine, non la larghezza dell'etichetta:
    ' sui fogli prefustellati fra una etichetta e l'altra c'e' uno stacco.
    Public Function Griglia(ByVal stampante As Object, ByVal etichetta As Etichetta, _
                            ByVal colonne As Long, ByVal righe As Long, _
                            ByVal margineSinistroMm As Double, _
                            ByVal margineAltoMm As Double, _
                            ByVal passoOrizzontaleMm As Double, _
                            ByVal passoVerticaleMm As Double) As Long
        Dim layout As LayoutEtichetta
        Dim problema As String
        Dim stampate As Long
        Dim posizione As Long
        Dim perPagina As Long
        Dim colonna As Long
        Dim riga As Long

        ControllaArgomenti stampante, etichetta

        If colonne < 1 Or righe < 1 Then
            Err.Raise 5, "Stampa.Griglia", "colonne e righe devono essere almeno uno"
        End If

        problema = etichetta.Valida()
        If Len(problema) > 0 Then
            Err.Raise 5, "Stampa.Griglia", "etichetta non stampabile: " & problema
        End If

        Set layout = ComposizioneEtichetta.Componi(etichetta)
        perPagina = colonne * righe

        Do While stampate < etichetta.Copie
            posizione = stampate Mod perPagina
            colonna = posizione Mod colonne
            riga = posizione \ colonne

            Disegno.Disegna stampante, layout, _
                            margineSinistroMm + colonna * passoOrizzontaleMm, _
                            margineAltoMm + riga * passoVerticaleMm

            stampate += 1

            ' Pagina piena e ancora copie da fare: si volta foglio.
            If (stampate Mod perPagina) = 0 And stampate < etichetta.Copie Then
                NuovaPagina stampante
            End If
        Loop

        ChiudiDocumento stampante
        Return stampate
    End Function

    ' ------------------------------------------------------------------
    ' Le due chiamate alla stampante
    ' ------------------------------------------------------------------

    ' Su una superficie che non e' una stampante, come una PictureBox usata
    ' per l'anteprima, NewPage e EndDoc non esistono: l'errore viene
    ' ignorato di proposito, cosi' lo stesso codice serve per stampare e per
    ' mostrare.
    Private Sub NuovaPagina(ByVal stampante As Object)
        On Error Resume Next
        stampante.NewPage
        Err.Clear
        On Error GoTo 0
    End Sub

    Private Sub ChiudiDocumento(ByVal stampante As Object)
        On Error Resume Next
        stampante.EndDoc
        Err.Clear
        On Error GoTo 0
    End Sub

    Private Sub ControllaArgomenti(ByVal stampante As Object, ByVal etichetta As Etichetta)
        If stampante Is Nothing Then
            Err.Raise 5, "Stampa", "stampante non puo' essere Nothing"
        End If
        If etichetta Is Nothing Then
            Err.Raise 5, "Stampa", "etichetta non puo' essere Nothing"
        End If
    End Sub

End Module

'
' Grafica - i tipi usati dal layout dell'etichetta.
'
' Stanno in un modulo e non dentro una classe perche' in twinBASIC, come in
' VB6, le enumerazioni dichiarate in un modulo sono visibili da tutto il
' progetto, mentre quelle dentro una classe no.
'
' Tutte le misure del layout sono in millimetri, mai in pixel o in twip:
' un'etichetta e' un oggetto fisico di misura nota, e i millimetri sono le
' uniche unita' che non cambiano al cambiare della risoluzione della
' stampante.
'
Module Grafica

    Public Enum TipoElemento
        teTesto = 0
        teLinea = 1
        teRettangolo = 2
        teBarcode = 3
    End Enum

    Public Enum Allineamento
        alSinistra = 0
        alCentro = 1
        alDestra = 2
    End Enum

    ' Un punto tipografico e' 1/72 di pollice, cioe' 0,352777... mm.
    Public Const MM_PER_PUNTO As Double = 0.3527778

    ' Interlinea: un carattere alto N punti occupa una riga alta N * 1,15.
    Private Const FATTORE_INTERLINEA As Double = 1.15

    ' Larghezza media di un carattere rispetto alla sua altezza. E' una
    ' stima: serve solo a decidere dove mandare a capo il testo, mentre
    ' l'allineamento viene calcolato a tempo di disegno con le misure vere
    ' del font. Lo 0,52 va bene per Arial e per i font senza grazie in
    ' genere; un font a larghezza fissa starebbe intorno a 0,6.
    Private Const FATTORE_LARGHEZZA As Double = 0.52

    Public Function AltezzaRigaMm(ByVal punti As Double) As Double
        Return punti * MM_PER_PUNTO * FATTORE_INTERLINEA
    End Function

    ' Quanti caratteri entrano, piu' o meno, in una larghezza data.
    Public Function CaratteriPerRiga(ByVal larghezzaMm As Double, _
                                     ByVal punti As Double) As Long
        Dim larghezzaCarattere As Double
        Dim quanti As Long

        If punti <= 0 Then
            Err.Raise 5, "Grafica.CaratteriPerRiga", "punti deve essere maggiore di zero"
        End If

        larghezzaCarattere = punti * MM_PER_PUNTO * FATTORE_LARGHEZZA
        quanti = Int(larghezzaMm / larghezzaCarattere)
        If quanti < 1 Then quanti = 1
        Return quanti
    End Function

End Module

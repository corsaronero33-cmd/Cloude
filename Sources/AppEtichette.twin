'
' AppEtichette - punto di ingresso del programma delle etichette.
'
' Impostare QUESTO modulo come Startup Object del progetto twinBASIC. Il
' modulo App che c'e' nel progetto e' il punto di ingresso della libreria di
' stringhe e resta dov'e': i due non si disturbano, si scambia solo lo
' Startup Object.
'
' Main fa tre cose: esegue la suite di test, mostra l'etichetta a caratteri e
' stampa il riepilogo degli allergeni di tutto il catalogo. Un singolo avvio
' dice quindi se il codice e' sano e che cosa produce, senza bisogno di una
' stampante ne' di un form.
'
Module AppEtichette

    Public Sub Main()
        EseguiTest
        ConsoleOut.WriteLine
        MostraEtichetta
        ConsoleOut.WriteLine
        MostraCatalogo
        ConsoleOut.WriteLine
        MostraRegistro
    End Sub

    ' ------------------------------------------------------------------

    Private Sub EseguiTest()
        Dim runner As TestRunner
        Set runner = New TestRunner

        ConsoleOut.WriteHeading "Etichette sushi - suite di test"
        StringUtilsTests.RunAll runner
        EtichetteTests.RunAll runner
        runner.Report
    End Sub

    ' L'etichetta a caratteri: le proporzioni e l'ordine delle righe sono
    ' quelli veri, i corpi dei caratteri no, perche' in una griglia di
    ' caratteri tutto il testo e' della stessa misura.
    Private Sub MostraEtichetta()
        Dim etichetta As Etichetta
        Dim layout As LayoutEtichetta

        Set etichetta = Esempi.EtichettaEsempio("MISTO-12")
        etichetta.Copie = 24
        Set layout = ComposizioneEtichetta.Componi(etichetta)

        ConsoleOut.WriteHeading "Anteprima dell'etichetta"
        ConsoleOut.WriteLine AnteprimaTesto.RendiConRiepilogo(layout)
        ConsoleOut.WriteLine
        ConsoleOut.WriteField "Lotto", etichetta.CodiceLotto()
        ConsoleOut.WriteField "Scadenza", DateUtil.FormattaDataOra(etichetta.Scadenza())
        ConsoleOut.WriteField "Codice a barre", _
            Code128.Gs1Leggibile(etichetta.Scadenza(), etichetta.CodiceLotto())
        ConsoleOut.WriteField "Moduli del barcode", _
            CStr(Code128.LarghezzaInModuli( _
                Code128.ElementiGs1(etichetta.Scadenza(), etichetta.CodiceLotto())))
    End Sub

    ' Il riepilogo che conviene rileggere ogni volta che si cambia una
    ' ricetta: per ogni prodotto, gli allergeni che il programma riconosce.
    ' Va confrontato con quello che c'e' davvero nella ricetta.
    Private Sub MostraCatalogo()
        Dim catalogo As Catalogo
        Dim p As Prodotto
        Dim i As Long
        Dim allergeniRilevati As String

        Set catalogo = Esempi.CatalogoEsempio()

        ConsoleOut.WriteHeading "Allergeni riconosciuti nel catalogo"
        For i = 1 To catalogo.Conteggio
            Set p = catalogo.Elemento(i)
            allergeniRilevati = p.AllergeniEffettivi()
            If Len(allergeniRilevati) = 0 Then allergeniRilevati = "(nessuno)"
            ConsoleOut.WriteField p.Codice, allergeniRilevati
        Next i

        ConsoleOut.WriteLine
        ConsoleOut.WriteLine "Da confermare prodotto per prodotto: il riconoscimento"
        ConsoleOut.WriteLine "automatico e' un aiuto alla compilazione, non una garanzia."
    End Sub

    Private Sub MostraRegistro()
        Dim registro As RegistroStampe
        Dim etichetta As Etichetta

        Set registro = New RegistroStampe
        Set etichetta = Esempi.EtichettaEsempio("SASH-TON")
        etichetta.PesoEffettivoGrammi = 150
        etichetta.Copie = 3

        ConsoleOut.WriteHeading "Riga del registro delle stampe"
        ConsoleOut.WriteLine registro.Intestazione()
        ConsoleOut.WriteLine registro.RigaDa(etichetta, "Mario", Esempi.DataDiProva())
    End Sub

End Module

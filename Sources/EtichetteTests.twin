'
' EtichetteTests - suite di test del programma delle etichette.
'
' Come StringUtilsTests, RunAll riceve il TestRunner invece di crearne uno,
' cosi' le due suite condividono il riepilogo finale.
'
' I vettori del codice a barre sono stati calcolati a mano e verificati
' contro la tabella dello standard: sono costanti letterali di proposito.
' Un test che ricalcolasse il risultato con la stessa funzione che sta
' provando non proverebbe nulla.
'
Module EtichetteTests

    ' GS1-128 di (17)261106(10)L261105-03, cioe' l'etichetta di esempio:
    ' start C, FNC1, le coppie di cifre, passaggio al sottoinsieme B, il
    ' lotto, il carattere di controllo 52 e lo stop. 222 moduli in tutto.
    Private Const GS1_ESEMPIO As String = _
        "211232" & "411131" & "123221" & "321221" & "231212" & "122213" & _
        "221312" & "114131" & "132131" & "223211" & "223112" & "123221" & _
        "123221" & "123122" & "213212" & "122132" & "123122" & "221132" & _
        "213311" & "2331112"

    Public Sub RunAll(ByVal runner As TestRunner)
        TestDate runner
        TestNumeri runner
        TestUtf8 runner
        TestCsv runner
        TestAllergeni runner
        TestLotto runner
        TestCode128 runner
        TestProdotto runner
        TestCatalogo runner
        TestAzienda runner
        TestEtichetta runner
        TestComposizione runner
        TestAnteprima runner
        TestRegistro runner
    End Sub

    ' ------------------------------------------------------------------
    ' Date
    ' ------------------------------------------------------------------

    Private Sub TestDate(ByVal runner As TestRunner)
        Dim d As Date
        d = DateSerial(2026, 11, 5) + TimeSerial(10, 30, 0)

        runner.BeginTest "Le date si formattano all'italiana, non secondo la lingua del PC"
        runner.AreEqual "05/11/2026", DateUtil.FormattaData(d)
        runner.AreEqual "05/11/26", DateUtil.FormattaDataBreve(d)
        runner.AreEqual "10:30", DateUtil.FormattaOra(d)
        runner.AreEqual "05/11/2026 10:30", DateUtil.FormattaDataOra(d)

        runner.BeginTest "FormattaAaMmGg produce il formato dei codici GS1"
        runner.AreEqual "261105", DateUtil.FormattaAaMmGg(d)
        runner.AreEqual "260101", DateUtil.FormattaAaMmGg(DateSerial(2026, 1, 1))

        runner.BeginTest "DueCifre mette lo zero davanti"
        runner.AreEqual "05", DateUtil.DueCifre(5)
        runner.AreEqual "00", DateUtil.DueCifre(0)
        runner.AreEqual "99", DateUtil.DueCifre(99)

        runner.BeginTest "AggiungiOre scavalca la mezzanotte"
        runner.AreEqual DateSerial(2026, 11, 6) + TimeSerial(10, 30, 0), _
                        DateUtil.AggiungiOre(d, 24)
        runner.AreEqual DateSerial(2026, 11, 6) + TimeSerial(2, 30, 0), _
                        DateUtil.AggiungiOre(d, 16)

        runner.BeginTest "SoloData azzera l'ora senza spostare il giorno"
        runner.AreEqual DateSerial(2026, 11, 5), DateUtil.SoloData(d)

        runner.BeginTest "FineGiornata porta alle 23:59 dello stesso giorno"
        runner.AreEqual DateSerial(2026, 11, 5) + TimeSerial(23, 59, 0), _
                        DateUtil.FineGiornata(d)

        runner.BeginTest "GiornoDellAnno conta dal primo gennaio"
        runner.AreEqual 1, DateUtil.GiornoDellAnno(DateSerial(2026, 1, 1))
        runner.AreEqual 309, DateUtil.GiornoDellAnno(DateSerial(2026, 11, 5))
        ' Il 2028 e' bisestile: il 31 dicembre e' il 366esimo giorno.
        runner.AreEqual 366, DateUtil.GiornoDellAnno(DateSerial(2028, 12, 31))
    End Sub

    ' ------------------------------------------------------------------
    ' Numeri
    ' ------------------------------------------------------------------

    Private Sub TestNumeri(ByVal runner As TestRunner)
        runner.BeginTest "I numeri usano la virgola, non il punto"
        runner.AreEqual "12,50", Numero.Formatta(12.5, 2)
        runner.AreEqual "0,00", Numero.Formatta(0, 2)
        runner.AreEqual "7", Numero.Formatta(7, 0)

        runner.BeginTest "L'arrotondamento parte dal mezzo verso l'alto"
        runner.AreEqual "12,35", Numero.Formatta(12.345, 2)
        runner.AreEqual "13", Numero.Formatta(12.5, 0)
        runner.AreEqual "0,01", Numero.Formatta(0.005, 2)

        runner.BeginTest "I negativi portano il segno, lo zero no"
        runner.AreEqual "-3,20", Numero.Formatta(-3.2, 2)
        runner.AreEqual "0,00", Numero.Formatta(-0.001, 2)

        runner.BeginTest "Interpreta accetta la virgola e il punto"
        runner.AreEqual 12.5, Numero.Interpreta("12,50")
        runner.AreEqual 12.5, Numero.Interpreta("12.50")
        runner.AreEqual 1234.56, Numero.Interpreta("1.234,56")
        runner.AreEqual 12.5, Numero.Interpreta(" 12,50 g ")
        runner.AreEqual 0, Numero.Interpreta("")
        runner.AreEqual 0, Numero.Interpreta("niente")

        runner.BeginTest "FormattaPeso passa ai chili sopra il chilo"
        runner.AreEqual "220 g", Numero.FormattaPeso(220)
        runner.AreEqual "999 g", Numero.FormattaPeso(999)
        runner.AreEqual "1 kg", Numero.FormattaPeso(1000)
        runner.AreEqual "1,2 kg", Numero.FormattaPeso(1200)
        runner.AreEqual "", Numero.FormattaPeso(0)
    End Sub

    ' ------------------------------------------------------------------
    ' UTF-8
    ' ------------------------------------------------------------------

    Private Sub TestUtf8(ByVal runner As TestRunner)
        Dim byt() As Byte
        Dim testo As String

        runner.BeginTest "Una lettera accentata occupa due byte"
        byt = Utf8File.Codifica(ChrW$(&HE0&))        ' la "a" con accento grave
        runner.AreEqual 2, Utf8File.NumeroDiByte(byt)
        runner.AreEqual &HC3&, CLng(byt(0))
        runner.AreEqual &HA0&, CLng(byt(1))

        runner.BeginTest "Il simbolo dell'euro occupa tre byte"
        byt = Utf8File.Codifica(ChrW$(&H20AC&))
        runner.AreEqual 3, Utf8File.NumeroDiByte(byt)
        runner.AreEqual &HE2&, CLng(byt(0))
        runner.AreEqual &H82&, CLng(byt(1))
        runner.AreEqual &HAC&, CLng(byt(2))

        runner.BeginTest "Il testo ASCII occupa un byte per carattere"
        byt = Utf8File.Codifica("Lotto")
        runner.AreEqual 5, Utf8File.NumeroDiByte(byt)

        runner.BeginTest "Codifica e decodifica si annullano"
        testo = "Citt" & ChrW$(&HE0&) & " di Nizza, " & ChrW$(&H20AC&) & " 12,50 - 0/+4 " & _
                ChrW$(176) & "C"
        byt = Utf8File.Codifica(testo)
        runner.AreEqual testo, Utf8File.Decodifica(byt)

        runner.BeginTest "Il testo vuoto non produce byte"
        byt = Utf8File.Codifica("")
        runner.AreEqual 0, Utf8File.NumeroDiByte(byt)
        runner.AreEqual "", Utf8File.Decodifica(byt)
    End Sub

    ' ------------------------------------------------------------------
    ' CSV
    ' ------------------------------------------------------------------

    Private Sub TestCsv(ByVal runner As TestRunner)
        Dim campi() As String
        Dim righe() As String
        Dim origine(0 To 2) As String

        Dim q As String
        q = Chr$(34)                    ' la virgoletta doppia, per leggibilita'

        runner.BeginTest "Proteggi virgoletta solo quando serve"
        runner.AreEqual "riso", CsvUtil.Proteggi("riso")
        runner.AreEqual "riso, aceto", CsvUtil.Proteggi("riso, aceto")
        runner.AreEqual q & "riso; aceto" & q, CsvUtil.Proteggi("riso; aceto")

        runner.BeginTest "Le virgolette interne vengono raddoppiate"
        ' un "alga"   diventa   "un ""alga"""
        runner.AreEqual q & "un " & q & q & "alga" & q & q & q, _
                        CsvUtil.Proteggi("un " & q & "alga" & q)

        runner.BeginTest "SpezzaRiga rispetta le virgolette"
        campi = CsvUtil.SpezzaRiga("a;b;c")
        runner.AreEqual 3, UBound(campi) - LBound(campi) + 1
        runner.AreEqual "b", campi(1)

        campi = CsvUtil.SpezzaRiga("a;""b;con;separatori"";c")
        runner.AreEqual 3, UBound(campi) - LBound(campi) + 1
        runner.AreEqual "b;con;separatori", campi(1)

        campi = CsvUtil.SpezzaRiga("a;""dice """"ciao"""""";c")
        runner.AreEqual "dice ""ciao""", campi(1)

        runner.BeginTest "Un campo vuoto resta un campo"
        campi = CsvUtil.SpezzaRiga("a;;c")
        runner.AreEqual 3, UBound(campi) - LBound(campi) + 1
        runner.AreEqual "", campi(1)

        runner.BeginTest "Comporre e spezzare si annullano"
        origine(0) = "riso; aceto"
        origine(1) = "dice ""ciao"""
        origine(2) = "semplice"
        campi = CsvUtil.SpezzaRiga(CsvUtil.ComponiRiga(origine))
        runner.AreEqual origine(0), campi(0)
        runner.AreEqual origine(1), campi(1)
        runner.AreEqual origine(2), campi(2)

        runner.BeginTest "SpezzaRighe scarta i commenti e le righe vuote"
        righe = CsvUtil.SpezzaRighe("# commento" & vbCrLf & "prima" & vbCrLf & _
                                    vbCrLf & "seconda" & vbLf & "   ")
        runner.AreEqual 2, UBound(righe) - LBound(righe) + 1
        runner.AreEqual "prima", righe(0)
        runner.AreEqual "seconda", righe(1)

        runner.BeginTest "Campo fuori dall'array vale il valore di ripiego"
        campi = CsvUtil.SpezzaRiga("solo")
        runner.AreEqual "solo", CsvUtil.Campo(campi, 0)
        runner.AreEqual "24", CsvUtil.Campo(campi, 7, "24")
    End Sub

    ' ------------------------------------------------------------------
    ' Allergeni
    ' ------------------------------------------------------------------

    Private Sub TestAllergeni(ByVal runner As TestRunner)
        runner.BeginTest "I nomi sono quelli dell'Allegato II, nel suo ordine"
        runner.AreEqual "Glutine", Allergeni.Nome(1)
        runner.AreEqual "Pesce", Allergeni.Nome(4)
        runner.AreEqual "Molluschi", Allergeni.Nome(14)

        runner.BeginTest "Rileva elenca gli allergeni nell'ordine dell'Allegato II"
        runner.AreEqual "Pesce", Allergeni.Rileva("riso, salmone")
        runner.AreEqual "Uova, Pesce, Sesamo", _
                        Allergeni.Rileva(Esempi.MakiCalifornia().Ingredienti)
        runner.AreEqual "Glutine, Pesce, Soia, Sesamo", _
                        Allergeni.Rileva(Esempi.PokeSalmone().Ingredienti)
        runner.AreEqual "Glutine, Crostacei, Uova, Pesce, Soia, Sesamo", _
                        Allergeni.Rileva(Esempi.SushiMisto().Ingredienti)

        runner.BeginTest "Un elenco senza allergeni non ne produce"
        runner.AreEqual "", Allergeni.Rileva("riso, aceto di riso, zucchero, sale")
        runner.AreEqual "", Allergeni.Rileva("")

        runner.BeginTest "Il riconoscimento si ferma ai confini di parola"
        runner.IsTrue Allergeni.Contiene("gamberetti sgusciati", 2), "gamberetti"
        runner.IsFalse Allergeni.Contiene("nocepesca sciroppata", 8), "nocepesca non e' noce"
        runner.IsTrue Allergeni.Contiene("noce e mandorle", 8), "noce intera"

        runner.BeginTest "Le accentate vengono riconosciute come le lettere semplici"
        runner.IsTrue Allergeni.Contiene("baccal" & ChrW$(&HE0&) & " dissalato", 4), "baccala"

        runner.BeginTest "Evidenzia mette in maiuscolo solo gli allergeni"
        runner.AreEqual "riso, SOIA, zucchero", Allergeni.Evidenzia("riso, soia, zucchero")
        runner.AreEqual "nocepesca e NOCE", Allergeni.Evidenzia("nocepesca e noce")

        runner.BeginTest "Evidenzia preferisce la parola chiave piu' lunga"
        runner.AreEqual "riso e SALSA DI SOIA", Allergeni.Evidenzia("riso e salsa di soia")

        runner.BeginTest "Evidenzia non cambia la lunghezza del testo"
        runner.AreEqual Len(Esempi.SushiMisto().Ingredienti), _
                        Len(Allergeni.Evidenzia(Esempi.SushiMisto().Ingredienti))
    End Sub

    ' ------------------------------------------------------------------
    ' Lotto
    ' ------------------------------------------------------------------

    Private Sub TestLotto(ByVal runner As TestRunner)
        Dim d As Date
        Dim data As Date
        Dim progressivo As Long
        Dim formato As Lotto.FormatoLotto
        Dim esito As Boolean

        d = DateSerial(2026, 11, 5)

        runner.BeginTest "Il lotto compatto porta la data in chiaro"
        runner.AreEqual "L261105-03", Lotto.Genera(d, 3)
        runner.AreEqual "L261105-01", Lotto.Genera(d)
        runner.AreEqual "X261105-12", Lotto.Genera(d, 12, "X")

        runner.BeginTest "Il lotto giuliano porta il giorno dell'anno"
        runner.AreEqual "L26309-03", Lotto.Genera(d, 3, "L", Lotto.lfGiuliano)
        runner.AreEqual "L26001-01", Lotto.Genera(DateSerial(2026, 1, 1), 1, "L", Lotto.lfGiuliano)

        runner.BeginTest "Interpreta ricostruisce data e progressivo"
        esito = Lotto.Interpreta("L261105-03", data, progressivo, formato)
        runner.IsTrue esito, "L261105-03 deve essere leggibile"
        runner.AreEqual d, data
        runner.AreEqual 3, progressivo
        runner.AreEqual CLng(Lotto.lfCompatto), CLng(formato)

        esito = Lotto.Interpreta("L26309-03", data, progressivo, formato)
        runner.IsTrue esito, "L26309-03 deve essere leggibile"
        runner.AreEqual d, data
        runner.AreEqual CLng(Lotto.lfGiuliano), CLng(formato)

        runner.BeginTest "Generare e interpretare si annullano in entrambi i formati"
        Lotto.Interpreta Lotto.Genera(d, 7, "AB"), data, progressivo, formato
        runner.AreEqual d, data
        runner.AreEqual 7, progressivo
        Lotto.Interpreta Lotto.Genera(d, 7, "AB", Lotto.lfGiuliano), data, progressivo, formato
        runner.AreEqual d, data
        runner.AreEqual 7, progressivo

        runner.BeginTest "I codici malformati vengono rifiutati senza errori"
        runner.IsFalse Lotto.EValido(""), "stringa vuota"
        runner.IsFalse Lotto.EValido("L261105"), "manca il progressivo"
        runner.IsFalse Lotto.EValido("L261145-01"), "il giorno 45 non esiste"
        runner.IsFalse Lotto.EValido("L261305-01"), "il mese 13 non esiste"
        runner.IsFalse Lotto.EValido("L261105-00"), "il progressivo parte da uno"
        runner.IsFalse Lotto.EValido("L26366-01"), "il 2026 non ha 366 giorni"
        runner.IsTrue Lotto.EValido("L28366-01"), "il 2028 e' bisestile"
    End Sub

    ' ------------------------------------------------------------------
    ' Code 128
    ' ------------------------------------------------------------------

    Private Sub TestCode128(ByVal runner As TestRunner)
        Dim valori(0 To 3) As Long
        Dim elementi As String

        runner.BeginTest "La tabella dei motivi rispetta le invarianti dello standard"
        runner.IsTrue Code128.TabellaValida(), _
                      "ogni motivo somma 11 moduli e ha un numero pari di moduli di barra"

        runner.BeginTest "Il carattere di controllo e' la somma pesata modulo 103"
        valori(0) = 104: valori(1) = 33: valori(2) = 34: valori(3) = 35   ' START B, A, B, C
        runner.AreEqual 1, Code128.CarattereDiControllo(valori, 4)

        valori(0) = 105: valori(1) = 12: valori(2) = 34                   ' START C, 12, 34
        runner.AreEqual 82, Code128.CarattereDiControllo(valori, 3)

        runner.BeginTest "Un testo di lettere usa il sottoinsieme B"
        elementi = Code128.Elementi("ABC")
        runner.AreEqual "211214" & "111323" & "131123" & "131321" & "222122" & "2331112", _
                        elementi
        runner.AreEqual 68, Code128.LarghezzaInModuli(elementi)

        runner.BeginTest "Quattro cifre usano il sottoinsieme C, che le comprime a coppie"
        elementi = Code128.Elementi("1234")
        runner.AreEqual "211232" & "112232" & "131123" & "121241" & "2331112", elementi
        runner.AreEqual 57, Code128.LarghezzaInModuli(elementi)

        runner.BeginTest "Il GS1-128 dell'etichetta di esempio e' quello atteso"
        elementi = Code128.ElementiGs1(DateSerial(2026, 11, 6) + TimeSerial(10, 30, 0), _
                                       "L261105-03")
        runner.AreEqual GS1_ESEMPIO, elementi
        runner.AreEqual 222, Code128.LarghezzaInModuli(elementi)

        runner.BeginTest "La versione leggibile mostra gli identificatori fra parentesi"
        runner.AreEqual "(17)261106(10)L261105-03", _
                        Code128.Gs1Leggibile(DateSerial(2026, 11, 6), "L261105-03")
        runner.AreEqual "(11)261105(17)261106(10)L261105-03", _
                        Code128.Gs1Leggibile(DateSerial(2026, 11, 6), "L261105-03", _
                                             DateSerial(2026, 11, 5), True)

        runner.BeginTest "Ogni elemento della sequenza e' larga da uno a quattro moduli"
        runner.IsTrue SoloCifreDaUnoAQuattro(GS1_ESEMPIO), "larghezze fuori range"

        runner.BeginTest "I caratteri non rappresentabili vengono rifiutati"
        On Error Resume Next
        Err.Clear
        Code128.Elementi("lotto " & ChrW$(&HE0&))
        runner.RaisedError 5, Err.Number, "una lettera accentata non sta in un Code 128"
        Err.Clear
        Code128.Elementi("")
        runner.RaisedError 5, Err.Number, "dati vuoti"
        Err.Clear
        On Error GoTo 0
    End Sub

    ' ------------------------------------------------------------------
    ' Prodotto
    ' ------------------------------------------------------------------

    Private Sub TestProdotto(ByVal runner As TestRunner)
        Dim p As Prodotto
        Dim produzione As Date

        produzione = Esempi.DataDiProva()

        runner.BeginTest "La scadenza e' la produzione piu' le ore di validita'"
        Set p = Esempi.NigiriSalmone()
        runner.AreEqual DateSerial(2026, 11, 6) + TimeSerial(10, 30, 0), _
                        p.ScadenzaDa(produzione)

        Set p = Esempi.MakiCalifornia()
        runner.AreEqual DateSerial(2026, 11, 7) + TimeSerial(10, 30, 0), _
                        p.ScadenzaDa(produzione)

        runner.BeginTest "Con ScadenzaAFineGiornata la scadenza va alle 23:59"
        Set p = Esempi.NigiriSalmone()
        p.ScadenzaAFineGiornata = True
        runner.AreEqual DateSerial(2026, 11, 6) + TimeSerial(23, 59, 0), _
                        p.ScadenzaDa(produzione)

        runner.BeginTest "Gli allergeni scritti a mano vincono su quelli riconosciuti"
        Set p = Esempi.NigiriSalmone()
        runner.AreEqual "Pesce", p.AllergeniEffettivi()
        p.AllergeniManuali = "Pesce, Molluschi"
        runner.AreEqual "Pesce, Molluschi", p.AllergeniEffettivi()

        runner.BeginTest "Il prezzo a peso si calcola sul peso pesato"
        Set p = Esempi.SashimiTonno()               ' 89 euro al chilo
        runner.AreEqual 8.9, p.PrezzoDa(100)
        runner.AreEqual 11.13, p.PrezzoDa(125)     ' 11,125 arrotondato
        runner.AreEqual 0, p.PrezzoDa(0)

        runner.BeginTest "Il prezzo a pezzo non dipende dal peso"
        Set p = Esempi.NigiriSalmone()
        runner.AreEqual 7.5, p.PrezzoDa(0)
        runner.AreEqual 7.5, p.PrezzoDa(999)

        runner.BeginTest "Il testo di conservazione porta i gradi col segno"
        Set p = Esempi.NigiriSalmone()
        runner.AreEqual "Conservare tra 0 " & ChrW$(176) & "C e +4 " & ChrW$(176) & "C", _
                        p.TestoConservazione()
        runner.AreEqual "Conservare 0/+4 " & ChrW$(176) & "C", p.TestoConservazione(True)

        runner.BeginTest "La provenienza unisce specie, metodo, zona e attrezzo"
        Set p = Esempi.SashimiTonno()
        runner.AreEqual "Tonno pinne gialle (Thunnus albacares) - Pescato - " & _
                        "FAO 51 - Oceano Indiano occidentale - Reti da circuizione", _
                        p.TestoProvenienza()

        runner.BeginTest "Un prodotto senza dati sulla pesca non ha riga di provenienza"
        runner.AreEqual "", Esempi.MakiCalifornia().TestoProvenienza()

        runner.BeginTest "Valida intercetta le schede incomplete"
        Set p = New Prodotto
        runner.IsFalse p.EValido(), "una scheda vuota non e' valida"
        p.Codice = "X"
        p.Denominazione = "Prova"
        p.Ingredienti = "riso"
        p.PesoNettoGrammi = 100
        runner.IsTrue p.EValido(), p.Valida()
        p.ValiditaOre = 0
        runner.IsFalse p.EValido(), "senza ore di validita' non e' valida"
        p.ValiditaOre = 24
        p.TemperaturaMin = 10
        p.TemperaturaMax = 4
        runner.IsFalse p.EValido(), "minima sopra la massima"

        runner.BeginTest "Copia e' indipendente dall'originale"
        Set p = Esempi.NigiriSalmone()
        Dim copia As Prodotto
        Set copia = p.Copia()
        copia.Denominazione = "Cambiato"
        runner.AreEqual "Nigiri di salmone 6 pezzi", p.Denominazione
        runner.AreEqual "Cambiato", copia.Denominazione
    End Sub

    ' ------------------------------------------------------------------
    ' Catalogo
    ' ------------------------------------------------------------------

    Private Sub TestCatalogo(ByVal runner As TestRunner)
        Dim c As Catalogo
        Dim riletto As Catalogo
        Dim p As Prodotto

        runner.BeginTest "Il catalogo di esempio contiene i cinque prodotti"
        Set c = Esempi.CatalogoEsempio()
        runner.AreEqual 5, c.Conteggio
        runner.IsTrue c.Contiene("MISTO-12"), "MISTO-12 presente"
        runner.IsTrue c.Contiene("misto-12"), "il codice non distingue le maiuscole"
        runner.IsFalse c.Contiene("INESISTENTE"), "codice assente"

        runner.BeginTest "PerCodice restituisce Nothing se il codice non c'e'"
        runner.IsTrue c.PerCodice("INESISTENTE") Is Nothing, "atteso Nothing"

        runner.BeginTest "Due prodotti con lo stesso codice non si possono aggiungere"
        On Error Resume Next
        Err.Clear
        c.Aggiungi Esempi.SushiMisto()
        runner.RaisedError 457, Err.Number, "codice duplicato"
        Err.Clear
        On Error GoTo 0

        runner.BeginTest "Scrivere e rileggere il CSV conserva tutti i campi"
        Set riletto = New Catalogo
        runner.AreEqual 5, riletto.CaricaDaTesto(c.TestoCsv())
        runner.AreEqual 0, riletto.NumeroErrori

        Set p = riletto.PerCodice("SASH-TON")
        runner.AreEqual "Sashimi di tonno", p.Denominazione
        runner.AreEqual 89, p.PrezzoKgEuro
        runner.AreEqual 0, p.PesoNettoGrammi
        runner.AreEqual 2, p.TemperaturaMax
        runner.IsTrue p.PesceCrudo, "SASH-TON e' pesce crudo"
        runner.AreEqual "Thunnus albacares", p.NomeScientifico
        runner.AreEqual "Reti da circuizione", p.AttrezzoPesca

        runner.BeginTest "Gli ingredienti con punto e virgola sopravvivono al CSV"
        Set c = New Catalogo
        Set p = Esempi.NigiriSalmone()
        p.Ingredienti = "riso; aceto; ""alga"""
        c.Aggiungi p
        Set riletto = New Catalogo
        riletto.CaricaDaTesto c.TestoCsv()
        runner.AreEqual "riso; aceto; ""alga""", riletto.PerCodice("NIG-SAL").Ingredienti

        runner.BeginTest "Una riga rovinata non impedisce di caricare le altre"
        Set riletto = New Catalogo
        runner.AreEqual 1, riletto.CaricaDaTesto( _
            "Codice;Denominazione;Ingredienti" & vbCrLf & _
            ";;;" & vbCrLf & _
            "BUONO;Prodotto buono;riso;;100;5,00;0;24" & vbCrLf)
        runner.AreEqual 1, riletto.NumeroErrori
        runner.IsTrue riletto.Contiene("BUONO"), "la riga buona e' stata caricata"

        runner.BeginTest "Le colonne mancanti in coda prendono il valore predefinito"
        Set riletto = New Catalogo
        riletto.CaricaDaTesto "CORTO;Prodotto corto;riso;;100;5,00"
        Set p = riletto.PerCodice("CORTO")
        runner.IsFalse p Is Nothing, "il prodotto va caricato comunque"
        runner.AreEqual 24, p.ValiditaOre
        runner.AreEqual 4, p.TemperaturaMax
    End Sub

    ' ------------------------------------------------------------------
    ' Azienda
    ' ------------------------------------------------------------------

    Private Sub TestAzienda(ByVal runner As TestRunner)
        Dim a As Azienda
        Dim riletta As Azienda

        Set a = Esempi.AziendaEsempio()

        runner.BeginTest "L'indirizzo si compone saltando i campi vuoti"
        runner.AreEqual "Via Giuseppe Verdi 14 - 20121 Milano (MI)", a.IndirizzoCompleto()

        runner.BeginTest "La riga del produttore porta anche il marchio CE"
        runner.AreEqual "Sakura Sushi di Mario Rossi - Via Giuseppe Verdi 14 - " & _
                        "20121 Milano (MI) - IT 1234 CE", a.RigaProduttore()

        runner.BeginTest "La larghezza utile toglie i due margini"
        runner.AreEqual 66, a.LarghezzaUtileMm()
        runner.AreEqual 46, a.AltezzaUtileMm()

        runner.BeginTest "Scrivere e rileggere le impostazioni conserva i valori"
        Set riletta = New Azienda
        riletta.CaricaDaTesto a.TestoImpostazioni()
        runner.AreEqual a.RagioneSociale, riletta.RagioneSociale
        runner.AreEqual a.MarchioIdentificazione, riletta.MarchioIdentificazione
        runner.AreEqual a.LarghezzaMm, riletta.LarghezzaMm
        runner.AreEqual a.AltezzaMm, riletta.AltezzaMm
        runner.AreEqual a.AvvisoAbbattimento, riletta.AvvisoAbbattimento
        runner.AreEqual CLng(a.FormatoCodiceLotto), CLng(riletta.FormatoCodiceLotto)
        runner.IsTrue riletta.MostraBarcode, "MostraBarcode conservato"

        runner.BeginTest "Il formato giuliano sopravvive al giro di scrittura"
        a.FormatoCodiceLotto = Lotto.lfGiuliano
        Set riletta = New Azienda
        riletta.CaricaDaTesto a.TestoImpostazioni()
        runner.AreEqual CLng(Lotto.lfGiuliano), CLng(riletta.FormatoCodiceLotto)

        runner.BeginTest "Una chiave sconosciuta non fa fallire il caricamento"
        Set riletta = New Azienda
        riletta.CaricaDaTesto "RagioneSociale = Prova" & vbCrLf & _
                              "ChiaveDelFuturo = qualcosa" & vbCrLf
        runner.AreEqual "Prova", riletta.RagioneSociale

        runner.BeginTest "Valida pretende ragione sociale e indirizzo"
        Set riletta = New Azienda
        runner.IsFalse Len(riletta.Valida()) = 0, "un'azienda vuota non e' valida"
        runner.IsTrue Len(Esempi.AziendaEsempio().Valida()) = 0, _
                      Esempi.AziendaEsempio().Valida()
    End Sub

    ' ------------------------------------------------------------------
    ' Etichetta
    ' ------------------------------------------------------------------

    Private Sub TestEtichetta(ByVal runner As TestRunner)
        Dim e As Etichetta

        Set e = Esempi.EtichettaEsempio()

        runner.BeginTest "Il lotto viene generato dalla data e dal progressivo"
        runner.AreEqual "L261105-03", e.CodiceLotto()

        runner.BeginTest "Il lotto scritto a mano vince su quello generato"
        e.LottoManuale = "L261104-01"
        runner.AreEqual "L261104-01", e.CodiceLotto()
        e.LottoManuale = ""
        runner.AreEqual "L261105-03", e.CodiceLotto()

        runner.BeginTest "La scadenza arriva dal prodotto"
        runner.AreEqual DateSerial(2026, 11, 6) + TimeSerial(10, 30, 0), e.Scadenza()

        runner.BeginTest "I testi delle date sono quelli da stampare"
        runner.AreEqual "Prodotto il 05/11/2026 ore 10:30", e.TestoProduzione()
        runner.AreEqual "Da consumare entro il 06/11/2026 ore 10:30", e.TestoScadenza()
        runner.AreEqual "DA CONSUMARE ENTRO 06/11/2026 10:30", e.TestoScadenza(True)
        runner.AreEqual "Lotto L261105-03", e.TestoLotto()

        runner.BeginTest "Il peso pesato vince su quello della scheda"
        runner.AreEqual 420, e.PesoGrammi()
        e.PesoEffettivoGrammi = 395
        runner.AreEqual 395, e.PesoGrammi()
        e.PesoEffettivoGrammi = 0
        runner.AreEqual 420, e.PesoGrammi()

        runner.BeginTest "Sul sashimi il prezzo segue il peso pesato"
        Set e = Esempi.EtichettaEsempio("SASH-TON")
        e.PesoEffettivoGrammi = 150
        runner.AreEqual 13.35, e.PrezzoEuro()         ' 89 euro/kg su 150 g

        runner.BeginTest "Un'etichetta di esempio e' stampabile"
        Set e = Esempi.EtichettaEsempio()
        runner.IsTrue e.EStampabile(), e.Valida()

        runner.BeginTest "Un lotto scritto a mano malformato blocca la stampa"
        e.LottoManuale = "qualcosa"
        runner.IsFalse e.EStampabile(), "lotto non valido"
        e.LottoManuale = ""

        runner.BeginTest "Zero copie bloccano la stampa"
        e.Copie = 0
        runner.IsFalse e.EStampabile(), "copie a zero"
        e.Copie = 1

        runner.BeginTest "Usare un'etichetta senza Prepara solleva l'errore 91"
        Dim nuda As Etichetta
        Set nuda = New Etichetta
        On Error Resume Next
        Err.Clear
        nuda.Scadenza
        runner.RaisedError 91, Err.Number, "oggetto non preparato"
        Err.Clear
        On Error GoTo 0
    End Sub

    ' ------------------------------------------------------------------
    ' Composizione
    ' ------------------------------------------------------------------

    Private Sub TestComposizione(ByVal runner As TestRunner)
        Dim layout As LayoutEtichetta
        Dim catalogo As Catalogo
        Dim e As Etichetta
        Dim i As Long

        runner.BeginTest "Il layout dell'etichetta di esempio entra nel supporto"
        Set layout = ComposizioneEtichetta.Componi(Esempi.EtichettaEsempio())
        runner.IsTrue layout.CiSta(), _
                      "sfora di " & Numero.Formatta(layout.Sforamento(), 1) & " mm"
        runner.AreEqual 70, layout.LarghezzaMm
        runner.AreEqual 50, layout.AltezzaMm

        runner.BeginTest "Tutti i prodotti del catalogo entrano in 70 x 50 mm"
        Set catalogo = Esempi.CatalogoEsempio()
        For i = 1 To catalogo.Conteggio
            Set e = New Etichetta
            e.Prepara catalogo.Elemento(i), Esempi.AziendaEsempio(), Esempi.DataDiProva(), 1
            Set layout = ComposizioneEtichetta.Componi(e)
            runner.IsTrue layout.CiSta(), _
                          catalogo.Elemento(i).Codice & " sfora di " & _
                          Numero.Formatta(layout.Sforamento(), 1) & " mm"
        Next i

        ' L'elenco degli ingredienti e' obbligatorio per intero: la
        ' composizione deve stringere i caratteri, non tagliare il testo.
        runner.BeginTest "Nessun prodotto del catalogo perde parte degli ingredienti"
        For i = 1 To catalogo.Conteggio
            Set e = New Etichetta
            e.Prepara catalogo.Elemento(i), Esempi.AziendaEsempio(), Esempi.DataDiProva(), 1
            Set layout = ComposizioneEtichetta.Componi(e)
            runner.IsFalse InStr(layout.TestoAvvisi(), "ABBREVIATO") > 0, _
                           catalogo.Elemento(i).Codice & ": " & layout.TestoAvvisi()
        Next i

        runner.BeginTest "Il testo integrale degli ingredienti finisce in etichetta"
        Set e = Esempi.EtichettaEsempio()
        Set layout = ComposizioneEtichetta.Componi(e)
        runner.AreEqual Len("Ingredienti: " & e.Scheda.IngredientiEvidenziati()), _
                        Len(TestoDeiParagrafi(layout, "Ingredienti:"))

        runner.BeginTest "Su un'etichetta troppo stretta l'abbreviazione viene segnalata"
        Set e = Esempi.EtichettaEsempio()
        e.Negozio.LarghezzaMm = 30
        e.Negozio.AltezzaMm = 30
        Set layout = ComposizioneEtichetta.Componi(e)
        runner.IsTrue InStr(layout.TestoAvvisi(), "ABBREVIATO") > 0, _
                      "atteso l'avviso di elenco abbreviato: " & layout.TestoAvvisi()

        runner.BeginTest "Nessun elemento esce dai bordi laterali"
        Set layout = ComposizioneEtichetta.Componi(Esempi.EtichettaEsempio())
        runner.IsTrue layout.LarghezzaUsataMm() <= layout.LarghezzaMm + 0.01, _
                      "larghezza usata " & Numero.Formatta(layout.LarghezzaUsataMm(), 1) & " mm"

        runner.BeginTest "Il layout contiene le informazioni obbligatorie"
        runner.IsTrue ContieneTesto(layout, "SUSHI MISTO 12 PEZZI"), "denominazione"
        runner.IsTrue ContieneTesto(layout, "DA CONSUMARE ENTRO 06/11/2026 10:30"), "scadenza"
        runner.IsTrue ContieneTesto(layout, "Lotto L261105-03"), "lotto"
        runner.IsTrue ContieneTesto(layout, "Prodotto il 05/11/2026 ore 10:30"), "produzione"
        runner.IsTrue ContieneParte(layout, "Ingredienti:"), "ingredienti"
        runner.IsTrue ContieneParte(layout, "Contiene:"), "allergeni"
        runner.IsTrue ContieneParte(layout, "Sakura Sushi"), "produttore"
        runner.IsTrue ContieneParte(layout, "Conservare"), "conservazione"
        runner.IsTrue ContieneParte(layout, "853/2004"), "avviso di abbattimento"

        runner.BeginTest "Il codice a barre c'e' ed e' quello giusto"
        runner.AreEqual 1, QuantiDiTipo(layout, Grafica.teBarcode)
        runner.AreEqual 222, Code128.LarghezzaInModuli(PrimoBarcode(layout).ElementiBarcode)
        runner.IsTrue ContieneParte(layout, "(17)261106(10)L261105-03"), _
                      "la versione leggibile sotto le barre"

        runner.BeginTest "Il codice a barre sta dentro la larghezza utile"
        runner.IsTrue PrimoBarcode(layout).DestraMm() <= 68.01, _
                      "il barcode arriva a " & _
                      Numero.Formatta(PrimoBarcode(layout).DestraMm(), 1) & " mm"

        runner.BeginTest "Senza barcode il layout non lo contiene"
        Set e = Esempi.EtichettaEsempio()
        e.Negozio.MostraBarcode = False
        Set layout = ComposizioneEtichetta.Componi(e)
        runner.AreEqual 0, QuantiDiTipo(layout, Grafica.teBarcode)

        runner.BeginTest "Un supporto troppo piccolo viene segnalato, non taciuto"
        Set e = Esempi.EtichettaEsempio()
        e.Negozio.AltezzaMm = 20
        Set layout = ComposizioneEtichetta.Componi(e)
        runner.IsFalse layout.CiSta(), "20 mm non bastano"
        runner.IsTrue layout.NumeroAvvisi > 0, "deve esserci un avviso"

        runner.BeginTest "Il prodotto non crudo non porta l'avviso di abbattimento"
        Set e = New Etichetta
        e.Prepara Esempi.MakiCalifornia(), Esempi.AziendaEsempio(), Esempi.DataDiProva(), 1
        Set layout = ComposizioneEtichetta.Componi(e)
        runner.IsFalse ContieneParte(layout, "853/2004"), "il maki california e' cotto"
    End Sub

    ' ------------------------------------------------------------------
    ' Anteprima
    ' ------------------------------------------------------------------

    Private Sub TestAnteprima(ByVal runner As TestRunner)
        Dim layout As LayoutEtichetta
        Dim testo As String
        Dim righe() As String

        Set layout = ComposizioneEtichetta.Componi(Esempi.EtichettaEsempio())
        testo = AnteprimaTesto.Rendi(layout, 74)
        righe = Split(testo, vbCrLf)

        runner.BeginTest "L'anteprima e' incorniciata e larga quanto richiesto"
        runner.AreEqual 76, Len(righe(0))                       ' 74 piu' i due angoli
        runner.AreEqual "+" & String$(74, "-") & "+", righe(0)
        runner.AreEqual "+" & String$(74, "-") & "+", righe(UBound(righe))

        runner.BeginTest "Ogni riga dell'anteprima ha la stessa lunghezza"
        runner.IsTrue TutteLunghe(righe, 76), "righe di lunghezza diversa"

        runner.BeginTest "L'anteprima mostra i dati dell'etichetta"
        runner.IsTrue InStr(testo, "SUSHI MISTO 12 PEZZI") > 0, "denominazione"
        runner.IsTrue InStr(testo, "L261105-03") > 0, "lotto"
        runner.IsTrue InStr(testo, "#") > 0, "le barre del codice"

        runner.BeginTest "Il riepilogo riporta le misure"
        testo = AnteprimaTesto.RendiConRiepilogo(layout, 74)
        runner.IsTrue InStr(testo, "70 x 50 mm") > 0, "misure del supporto"

        runner.BeginTest "Meno di venti colonne non e' un'anteprima"
        On Error Resume Next
        Err.Clear
        AnteprimaTesto.Rendi layout, 5
        runner.RaisedError 5, Err.Number, "colonne insufficienti"
        Err.Clear
        On Error GoTo 0
    End Sub

    ' ------------------------------------------------------------------
    ' Registro
    ' ------------------------------------------------------------------

    Private Sub TestRegistro(ByVal runner As TestRunner)
        Dim registro As RegistroStampe
        Dim e As Etichetta
        Dim riga As String
        Dim campi() As String

        Set registro = New RegistroStampe
        Set e = Esempi.EtichettaEsempio()
        e.Copie = 12

        runner.BeginTest "La riga del registro porta lotto, date e copie"
        riga = registro.RigaDa(e, "Mario", DateSerial(2026, 11, 5) + TimeSerial(10, 35, 0))
        campi = CsvUtil.SpezzaRiga(riga)
        runner.AreEqual "05/11/2026 10:35", campi(0)
        runner.AreEqual "MISTO-12", campi(1)
        runner.AreEqual "Sushi misto 12 pezzi", campi(2)
        runner.AreEqual "L261105-03", campi(3)
        runner.AreEqual "05/11/2026 10:30", campi(4)
        runner.AreEqual "06/11/2026 10:30", campi(5)
        runner.AreEqual "12", campi(6)
        runner.AreEqual "420,0", campi(7)
        runner.AreEqual "16,90", campi(8)
        runner.AreEqual "Mario", campi(9)

        runner.BeginTest "L'intestazione ha tante colonne quanti i campi"
        runner.AreEqual UBound(CsvUtil.SpezzaRiga(registro.Intestazione())) + 1, _
                        UBound(campi) + 1

        runner.BeginTest "Registrare senza percorso solleva un errore invece di tacere"
        On Error Resume Next
        Err.Clear
        registro.Registra e, "Mario"
        runner.RaisedError 5, Err.Number, "percorso non impostato"
        Err.Clear
        On Error GoTo 0
    End Sub

    ' ------------------------------------------------------------------
    ' Helper dei test
    ' ------------------------------------------------------------------

    ' Vero se il layout ha un elemento di testo esattamente uguale.
    Private Function ContieneTesto(ByVal layout As LayoutEtichetta, ByVal testo As String) As Boolean
        Dim i As Long

        For i = 1 To layout.Conteggio
            If layout.Elemento(i).Tipo = Grafica.teTesto Then
                If layout.Elemento(i).Testo = testo Then Return True
            End If
        Next i
        Return False
    End Function

    ' Vero se un elemento di testo contiene quel pezzo. Serve per i testi
    ' mandati a capo, che finiscono spezzati su piu' elementi.
    Private Function ContieneParte(ByVal layout As LayoutEtichetta, ByVal parte As String) As Boolean
        Dim i As Long

        For i = 1 To layout.Conteggio
            If layout.Elemento(i).Tipo = Grafica.teTesto Then
                If InStr(layout.Elemento(i).Testo, parte) > 0 Then Return True
            End If
        Next i
        Return False
    End Function

    ' Rimette insieme le righe di un paragrafo mandato a capo, per
    ' controllare che il testo sia arrivato in etichetta tutto intero.
    ' Le righe vengono riunite con uno spazio, come le ha separate WordWrap.
    '
    ' Il paragrafo finisce dove cambia il corpo del carattere: le righe di
    ' uno stesso paragrafo hanno tutte lo stesso corpo, e il blocco che
    ' segue ne ha sempre uno diverso. Fermarsi al primo elemento che non e'
    ' testo non basterebbe, perche' fra un paragrafo e l'altro non c'e'
    ' nessun separatore.
    Private Function TestoDeiParagrafi(ByVal layout As LayoutEtichetta, _
                                       ByVal prefisso As String) As String
        Dim i As Long
        Dim risultato As String
        Dim punti As Double
        Dim e As ElementoEtichetta

        For i = 1 To layout.Conteggio
            Set e = layout.Elemento(i)
            If e.Tipo <> Grafica.teTesto Then
                If Len(risultato) > 0 Then Exit For
            ElseIf Len(risultato) = 0 Then
                If InStr(e.Testo, prefisso) = 1 Then
                    risultato = e.Testo
                    punti = e.PuntiFont
                End If
            ElseIf e.PuntiFont = punti Then
                risultato = risultato & " " & e.Testo
            Else
                Exit For
            End If
        Next i
        Return risultato
    End Function

    Private Function QuantiDiTipo(ByVal layout As LayoutEtichetta, _
                                  ByVal tipo As Grafica.TipoElemento) As Long
        Dim i As Long
        Dim quanti As Long

        For i = 1 To layout.Conteggio
            If layout.Elemento(i).Tipo = tipo Then quanti += 1
        Next i
        Return quanti
    End Function

    Private Function PrimoBarcode(ByVal layout As LayoutEtichetta) As ElementoEtichetta
        Dim i As Long

        For i = 1 To layout.Conteggio
            If layout.Elemento(i).Tipo = Grafica.teBarcode Then Return layout.Elemento(i)
        Next i
        Return Nothing
    End Function

    Private Function SoloCifreDaUnoAQuattro(ByVal elementi As String) As Boolean
        Dim i As Long
        Dim ch As String

        If Len(elementi) = 0 Then Return False
        For i = 1 To Len(elementi)
            ch = Mid$(elementi, i, 1)
            If ch < "1" Or ch > "4" Then Return False
        Next i
        Return True
    End Function

    Private Function TutteLunghe(ByRef righe() As String, ByVal lunghezza As Long) As Boolean
        Dim i As Long

        For i = LBound(righe) To UBound(righe)
            If Len(righe(i)) <> lunghezza Then Return False
        Next i
        Return True
    End Function

End Module

'
' Prodotto - la scheda di un prodotto del laboratorio.
'
' E' un contenitore di dati, quindi i campi sono pubblici: un giro di
' Property Get e Property Let che non fanno altro che leggere e scrivere una
' variabile privata aggiungerebbe duecento righe senza aggiungere nulla.
' La logica che vale la pena di avere qui dentro e' quella che dipende da piu'
' campi insieme: la scadenza, gli allergeni, la validazione.
'
' I campi sulla pesca (specie, zona di cattura, attrezzo) servono ai prodotti
' della pesca destinati al consumatore finale, per i quali il Reg. UE 1379/2013
' chiede denominazione commerciale e scientifica, metodo di produzione, zona
' di cattura e categoria di attrezzo da pesca.
'
Class Prodotto

    ' --- Identificazione -----------------------------------------------
    Public Codice As String             ' codice interno, es. "NIG-SAL"
    Public Denominazione As String      ' nome in etichetta, es. "Nigiri di salmone"

    ' --- Composizione --------------------------------------------------
    Public Ingredienti As String        ' elenco in ordine di peso decrescente
    Public AllergeniManuali As String   ' se compilato vince sul rilevamento

    ' --- Quantita' e prezzo --------------------------------------------
    Public PesoNettoGrammi As Double    ' 0 = da pesare al momento
    Public PrezzoPezzoEuro As Double    ' prezzo della confezione
    Public PrezzoKgEuro As Double       ' prezzo al chilo, se vendita a peso

    ' --- Durata e conservazione ----------------------------------------
    Public ValiditaOre As Long          ' ore dalla produzione alla scadenza
    Public ScadenzaAFineGiornata As Boolean  ' arrotonda la scadenza alle 23:59
    Public TemperaturaMin As Double     ' gradi centigradi
    Public TemperaturaMax As Double

    ' --- Pesce ---------------------------------------------------------
    Public PesceCrudo As Boolean        ' fa stampare l'avviso di abbattimento
    Public SpecieCommerciale As String  ' es. "Salmone atlantico"
    Public NomeScientifico As String    ' es. "Salmo salar"
    Public MetodoProduzione As String   ' es. "Allevato" oppure "Pescato"
    Public ZonaCattura As String        ' es. "FAO 27 - Atlantico nord-orientale"
    Public AttrezzoPesca As String      ' es. "Reti da circuizione"

    ' --- Varie ---------------------------------------------------------
    Public Note As String               ' riga libera in fondo all'etichetta

    Private Sub Class_Initialize()
        ValiditaOre = 24
        TemperaturaMin = 0
        TemperaturaMax = 4
    End Sub

    ' ------------------------------------------------------------------
    ' Logica
    ' ------------------------------------------------------------------

    ' Gli allergeni da stampare: quelli scritti a mano se ci sono, altrimenti
    ' quelli riconosciuti nell'elenco ingredienti.
    Public Function AllergeniEffettivi() As String
        If Len(Trim$(AllergeniManuali)) > 0 Then Return Trim$(AllergeniManuali)
        Return Allergeni.Rileva(Ingredienti)
    End Function

    ' L'elenco ingredienti con gli allergeni in maiuscolo, come chiede
    ' l'articolo 21 del Reg. UE 1169/2011.
    Public Function IngredientiEvidenziati() As String
        Return Allergeni.Evidenzia(Ingredienti)
    End Function

    ' Data e ora di scadenza a partire dal momento della produzione.
    Public Function ScadenzaDa(ByVal dataOraProduzione As Date) As Date
        Dim scadenza As Date

        If ValiditaOre <= 0 Then
            Err.Raise 5, "Prodotto.ScadenzaDa", _
                      "ValiditaOre del prodotto " & Codice & " deve essere maggiore di zero"
        End If

        scadenza = DateUtil.AggiungiOre(dataOraProduzione, ValiditaOre)
        If ScadenzaAFineGiornata Then scadenza = DateUtil.FineGiornata(scadenza)
        Return scadenza
    End Function

    ' "Conservare tra 0 °C e +4 °C", oppure "Conservare 0/+4 °C" nella forma
    ' compatta per le etichette piccole.
    Public Function TestoConservazione(Optional ByVal compatto As Boolean = False) As String
        If compatto Then
            Return "Conservare " & Gradi(TemperaturaMin, False) & "/" & _
                   Gradi(TemperaturaMax, False) & " " & ChrW$(176) & "C"
        End If
        Return "Conservare tra " & Gradi(TemperaturaMin, True) & " e " & _
               Gradi(TemperaturaMax, True)
    End Function

    ' Prezzo da stampare. Con un peso effettivo e un prezzo al chilo calcola
    ' il prezzo di quella confezione; altrimenti usa il prezzo del pezzo.
    Public Function PrezzoDa(ByVal pesoGrammi As Double) As Double
        If PrezzoKgEuro > 0 And pesoGrammi > 0 Then
            Return ArrotondaCentesimi(PrezzoKgEuro * pesoGrammi / 1000)
        End If
        Return ArrotondaCentesimi(PrezzoPezzoEuro)
    End Function

    ' La riga sulla provenienza del pesce, vuota se i campi non sono
    ' compilati. Il nome scientifico va fra parentesi dopo quello commerciale.
    Public Function TestoProvenienza() As String
        Dim risultato As String

        If Len(Trim$(SpecieCommerciale)) > 0 Then
            risultato = Trim$(SpecieCommerciale)
            If Len(Trim$(NomeScientifico)) > 0 Then
                risultato = risultato & " (" & Trim$(NomeScientifico) & ")"
            End If
        End If

        If Len(Trim$(MetodoProduzione)) > 0 Then
            risultato = Unisci(risultato, Trim$(MetodoProduzione))
        End If
        If Len(Trim$(ZonaCattura)) > 0 Then
            risultato = Unisci(risultato, Trim$(ZonaCattura))
        End If
        If Len(Trim$(AttrezzoPesca)) > 0 Then
            risultato = Unisci(risultato, Trim$(AttrezzoPesca))
        End If

        Return risultato
    End Function

    ' Descrizione del primo problema trovato, stringa vuota se la scheda e'
    ' completa. Non solleva errori: serve a mostrare un messaggio sensato
    ' all'operatore, non a interrompere il programma.
    Public Function Valida() As String
        If Len(Trim$(Codice)) = 0 Then Return "Il codice del prodotto e' obbligatorio."
        If Len(Trim$(Denominazione)) = 0 Then Return "La denominazione e' obbligatoria."
        If Len(Trim$(Ingredienti)) = 0 Then Return "L'elenco degli ingredienti e' obbligatorio."
        If ValiditaOre <= 0 Then Return "Le ore di validita' devono essere maggiori di zero."
        If TemperaturaMin > TemperaturaMax Then
            Return "La temperatura minima non puo' superare la massima."
        End If
        If PesoNettoGrammi < 0 Then Return "Il peso netto non puo' essere negativo."
        If PrezzoPezzoEuro < 0 Or PrezzoKgEuro < 0 Then
            Return "I prezzi non possono essere negativi."
        End If
        If PesoNettoGrammi = 0 And PrezzoKgEuro = 0 And PrezzoPezzoEuro = 0 Then
            Return "Serve almeno un peso netto o un prezzo."
        End If
        Return ""
    End Function

    Public Function EValido() As Boolean
        Return (Len(Valida()) = 0)
    End Function

    ' Copia profonda, usata dall'anteprima per lavorare su una scheda senza
    ' toccare quella del catalogo.
    Public Function Copia() As Prodotto
        Dim altro As Prodotto
        Set altro = New Prodotto

        altro.Codice = Codice
        altro.Denominazione = Denominazione
        altro.Ingredienti = Ingredienti
        altro.AllergeniManuali = AllergeniManuali
        altro.PesoNettoGrammi = PesoNettoGrammi
        altro.PrezzoPezzoEuro = PrezzoPezzoEuro
        altro.PrezzoKgEuro = PrezzoKgEuro
        altro.ValiditaOre = ValiditaOre
        altro.ScadenzaAFineGiornata = ScadenzaAFineGiornata
        altro.TemperaturaMin = TemperaturaMin
        altro.TemperaturaMax = TemperaturaMax
        altro.PesceCrudo = PesceCrudo
        altro.SpecieCommerciale = SpecieCommerciale
        altro.NomeScientifico = NomeScientifico
        altro.MetodoProduzione = MetodoProduzione
        altro.ZonaCattura = ZonaCattura
        altro.AttrezzoPesca = AttrezzoPesca
        altro.Note = Note

        Return altro
    End Function

    ' ------------------------------------------------------------------
    ' Helper privati
    ' ------------------------------------------------------------------

    ' Temperatura con il segno davanti. Lo zero non prende il segno.
    Private Function Gradi(ByVal valore As Double, ByVal conUnita As Boolean) As String
        Dim testo As String

        testo = Numero.Formatta(valore, 0)
        If valore > 0 Then testo = "+" & testo

        If conUnita Then testo = testo & " " & ChrW$(176) & "C"
        Return testo
    End Function

    Private Function ArrotondaCentesimi(ByVal valore As Double) As Double
        Return Int(valore * 100 + 0.5) / 100
    End Function

    Private Function Unisci(ByVal a As String, ByVal b As String) As String
        If Len(a) = 0 Then Return b
        If Len(b) = 0 Then Return a
        Return a & " - " & b
    End Function

End Class

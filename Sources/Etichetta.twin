'
' Etichetta - una stampa concreta: quale prodotto, prodotto quando, che lotto.
'
' E' la fotografia del momento in cui si stampa. Il prodotto dice cosa c'e'
' dentro la confezione e quanto dura, l'etichetta dice quando quella
' confezione e' stata fatta: da qui escono il lotto, la scadenza e il prezzo.
'
' I due riferimenti si chiamano Scheda e Negozio e non Prodotto e Azienda per
' non dare a un membro lo stesso nome della sua classe, che e' un'ambiguita'
' che non conviene mai lasciare al compilatore.
'
Class Etichetta

    Private mScheda As Prodotto
    Private mNegozio As Azienda

    Public DataOraProduzione As Date
    Public ProgressivoLotto As Long

    ' Se compilato vince sul lotto calcolato. Serve quando si ristampa
    ' l'etichetta di una lavorazione di ieri e il lotto e' quello di ieri.
    Public LottoManuale As String

    ' Peso pesato al momento del confezionamento. Zero vuol dire "usa il peso
    ' fisso della scheda prodotto".
    Public PesoEffettivoGrammi As Double

    Public Copie As Long

    Private Sub Class_Initialize()
        DataOraProduzione = Now
        ProgressivoLotto = 1
        Copie = 1
    End Sub

    ' ------------------------------------------------------------------
    ' Preparazione
    ' ------------------------------------------------------------------

    Public Sub Prepara(ByVal scheda As Prodotto, ByVal negozio As Azienda, _
                       Optional ByVal dataOraProduzione As Variant, _
                       Optional ByVal progressivo As Long = 1)
        If scheda Is Nothing Then
            Err.Raise 5, "Etichetta.Prepara", "scheda non puo' essere Nothing"
        End If
        If negozio Is Nothing Then
            Err.Raise 5, "Etichetta.Prepara", "negozio non puo' essere Nothing"
        End If

        Set mScheda = scheda
        Set mNegozio = negozio
        If Not IsMissing(dataOraProduzione) Then
            DataOraProduzione = CDate(dataOraProduzione)
        End If
        ProgressivoLotto = progressivo
    End Sub

    Public Property Get Scheda() As Prodotto
        Return mScheda
    End Property

    Public Property Get Negozio() As Azienda
        Return mNegozio
    End Property

    ' ------------------------------------------------------------------
    ' Valori calcolati
    ' ------------------------------------------------------------------

    Public Function Scadenza() As Date
        ControllaPreparata
        Return mScheda.ScadenzaDa(DataOraProduzione)
    End Function

    ' Il codice di lotto: quello scritto a mano se c'e', altrimenti quello
    ' generato dalla data di produzione e dal progressivo.
    Public Function CodiceLotto() As String
        ControllaPreparata
        If Len(Trim$(LottoManuale)) > 0 Then Return Trim$(UCase$(LottoManuale))
        Return Lotto.Genera(DataOraProduzione, ProgressivoLotto, _
                            mNegozio.PrefissoLotto, mNegozio.FormatoCodiceLotto)
    End Function

    ' Il peso da stampare: quello pesato se c'e', altrimenti quello fisso.
    Public Function PesoGrammi() As Double
        ControllaPreparata
        If PesoEffettivoGrammi > 0 Then Return PesoEffettivoGrammi
        Return mScheda.PesoNettoGrammi
    End Function

    Public Function PrezzoEuro() As Double
        ControllaPreparata
        Return mScheda.PrezzoDa(PesoGrammi())
    End Function

    ' ------------------------------------------------------------------
    ' Testi dell'etichetta
    ' ------------------------------------------------------------------

    ' "Da consumare entro il 06/11/2026 ore 10:30".
    '
    ' Per i prodotti molto deperibili il Reg. UE 1169/2011 vuole la data di
    ' scadenza, non il termine minimo di conservazione: la formula e' "da
    ' consumare entro" e non "da consumare preferibilmente entro". Il sushi
    ' con pesce crudo sta sempre nel primo caso.
    Public Function TestoScadenza(Optional ByVal compatto As Boolean = False) As String
        Dim scad As Date

        scad = Scadenza()
        If compatto Then
            Return "DA CONSUMARE ENTRO " & DateUtil.FormattaData(scad) & " " & _
                   DateUtil.FormattaOra(scad)
        End If
        Return "Da consumare entro il " & DateUtil.FormattaData(scad) & _
               " ore " & DateUtil.FormattaOra(scad)
    End Function

    Public Function TestoProduzione() As String
        Return "Prodotto il " & DateUtil.FormattaData(DataOraProduzione) & _
               " ore " & DateUtil.FormattaOra(DataOraProduzione)
    End Function

    Public Function TestoLotto() As String
        Return "Lotto " & CodiceLotto()
    End Function

    ' ------------------------------------------------------------------
    ' Controlli
    ' ------------------------------------------------------------------

    ' Descrizione del primo problema, stringa vuota se si puo' stampare.
    Public Function Valida() As String
        Dim problema As String

        If mScheda Is Nothing Then Return "Nessun prodotto selezionato."
        If mNegozio Is Nothing Then Return "Dati del negozio non caricati."

        problema = mScheda.Valida()
        If Len(problema) > 0 Then Return problema

        problema = mNegozio.Valida()
        If Len(problema) > 0 Then Return problema

        If Copie < 1 Then Return "Il numero di copie deve essere almeno uno."
        If PesoEffettivoGrammi < 0 Then Return "Il peso pesato non puo' essere negativo."

        If Len(Trim$(LottoManuale)) > 0 Then
            If Not Lotto.EValido(LottoManuale) Then
                Return "Il lotto '" & LottoManuale & "' non ha una forma valida: " & _
                       "atteso qualcosa come " & _
                       Lotto.Genera(DataOraProduzione, 1, mNegozio.PrefissoLotto, _
                                    mNegozio.FormatoCodiceLotto) & "."
            End If
        End If

        If Scadenza() <= DataOraProduzione Then
            Return "La scadenza calcolata non e' successiva alla produzione."
        End If

        Return ""
    End Function

    Public Function EStampabile() As Boolean
        Return (Len(Valida()) = 0)
    End Function

    ' Riga per il registro delle stampe.
    Public Function Descrizione() As String
        ControllaPreparata
        Return mScheda.Codice & " " & mScheda.Denominazione & _
               " - lotto " & CodiceLotto() & _
               " - scad. " & DateUtil.FormattaDataOra(Scadenza())
    End Function

    Private Sub ControllaPreparata()
        If mScheda Is Nothing Or mNegozio Is Nothing Then
            Err.Raise 91, "Etichetta", _
                      "chiamare Prepara prima di usare l'etichetta"
        End If
    End Sub

End Class

'
' Catalogo - l'elenco dei prodotti del laboratorio, con lettura e scrittura
' su un CSV che si puo' aprire e correggere anche con Excel.
'
' Il caricamento e' tollerante per scelta: una riga sbagliata non fa fallire
' tutto il file, viene messa da parte e segnalata in Errori. Se il file dei
' prodotti si corrompe, il negozio deve poter stampare le etichette dei
' prodotti rimasti leggibili invece di trovarsi il programma bloccato.
'
' Le colonne mancanti in coda valgono il loro valore predefinito, cosi' un
' file scritto da una versione precedente si apre comunque.
'
Class Catalogo

    Private Const COLONNE As String = _
        "Codice;Denominazione;Ingredienti;AllergeniManuali;PesoNettoGrammi;" & _
        "PrezzoPezzoEuro;PrezzoKgEuro;ValiditaOre;ScadenzaAFineGiornata;" & _
        "TemperaturaMin;TemperaturaMax;PesceCrudo;SpecieCommerciale;" & _
        "NomeScientifico;MetodoProduzione;ZonaCattura;AttrezzoPesca;Note"

    Private mProdotti As Collection
    Private mErrori As Collection

    Private Sub Class_Initialize()
        Set mProdotti = New Collection
        Set mErrori = New Collection
    End Sub

    ' ------------------------------------------------------------------
    ' Contenuto
    ' ------------------------------------------------------------------

    Public Property Get Conteggio() As Long
        Return mProdotti.Count
    End Property

    ' Prodotto in posizione indice, da 1 a Conteggio.
    Public Function Elemento(ByVal indice As Long) As Prodotto
        Return mProdotti.Item(indice)
    End Function

    ' Prodotto con quel codice, Nothing se non c'e'. Il confronto non
    ' distingue maiuscole e minuscole.
    Public Function PerCodice(ByVal codice As String) As Prodotto
        Dim trovato As Prodotto

        On Error Resume Next
        Set trovato = mProdotti.Item(Chiave(codice))
        If Err.Number <> 0 Then
            Err.Clear
            Return Nothing
        End If
        On Error GoTo 0

        Return trovato
    End Function

    Public Function Contiene(ByVal codice As String) As Boolean
        Return Not (PerCodice(codice) Is Nothing)
    End Function

    ' Aggiunge un prodotto. Un codice gia' presente solleva l'errore 457,
    ' lo stesso che userebbe una Collection: due prodotti con lo stesso
    ' codice renderebbero impossibile risalire dal lotto alla scheda.
    Public Sub Aggiungi(ByVal prodotto As Prodotto)
        If prodotto Is Nothing Then
            Err.Raise 5, "Catalogo.Aggiungi", "prodotto non puo' essere Nothing"
        End If
        If Len(Trim$(prodotto.Codice)) = 0 Then
            Err.Raise 5, "Catalogo.Aggiungi", "il prodotto non ha un codice"
        End If
        If Contiene(prodotto.Codice) Then
            Err.Raise 457, "Catalogo.Aggiungi", _
                      "esiste gia' un prodotto con codice " & prodotto.Codice
        End If
        mProdotti.Add prodotto, Chiave(prodotto.Codice)
    End Sub

    ' Aggiunge o sostituisce, secondo il codice.
    Public Sub Imposta(ByVal prodotto As Prodotto)
        If Contiene(prodotto.Codice) Then Rimuovi prodotto.Codice
        Aggiungi prodotto
    End Sub

    Public Sub Rimuovi(ByVal codice As String)
        If Not Contiene(codice) Then
            Err.Raise 5, "Catalogo.Rimuovi", "nessun prodotto con codice " & codice
        End If
        mProdotti.Remove Chiave(codice)
    End Sub

    Public Sub Svuota()
        Set mProdotti = New Collection
        Set mErrori = New Collection
    End Sub

    ' ------------------------------------------------------------------
    ' Errori dell'ultimo caricamento
    ' ------------------------------------------------------------------

    Public Property Get NumeroErrori() As Long
        Return mErrori.Count
    End Property

    Public Function Errore(ByVal indice As Long) As String
        Return mErrori.Item(indice)
    End Function

    ' Tutti gli errori su righe separate, per mostrarli in un messaggio.
    Public Function TestoErrori() As String
        Dim risultato As String
        Dim i As Long

        For i = 1 To mErrori.Count
            If i > 1 Then risultato = risultato & vbCrLf
            risultato = risultato & mErrori.Item(i)
        Next i
        Return risultato
    End Function

    ' ------------------------------------------------------------------
    ' CSV
    ' ------------------------------------------------------------------

    Public Function TestoCsv() As String
        Dim risultato As String
        Dim i As Long

        risultato = COLONNE & vbCrLf
        For i = 1 To mProdotti.Count
            risultato = risultato & RigaDaProdotto(Elemento(i)) & vbCrLf
        Next i
        Return risultato
    End Function

    ' Carica dal testo di un CSV. Svuota il catalogo prima di cominciare.
    ' Restituisce quanti prodotti ha caricato; le righe scartate finiscono
    ' in Errore/TestoErrori.
    Public Function CaricaDaTesto(ByVal testo As String) As Long
        Dim righe() As String
        Dim campi() As String
        Dim prodotto As Prodotto
        Dim i As Long
        Dim primaRiga As Long
        Dim problema As String

        Svuota

        righe = CsvUtil.SpezzaRighe(testo)
        If NumeroDiRighe(righe) = 0 Then Return 0

        ' Salta l'intestazione, se c'e'.
        primaRiga = LBound(righe)
        If InStr(1, righe(primaRiga), "Codice", vbTextCompare) = 1 Then
            primaRiga += 1
        End If

        For i = primaRiga To UBound(righe)
            campi = CsvUtil.SpezzaRiga(righe(i))

            On Error Resume Next
            Set prodotto = ProdottoDaCampi(campi)
            If Err.Number <> 0 Then
                mErrori.Add "Riga " & CStr(i + 1) & ": " & Err.Description
                Err.Clear
                Set prodotto = Nothing
            End If
            On Error GoTo 0

            If Not prodotto Is Nothing Then
                problema = prodotto.Valida()
                If Len(problema) > 0 Then
                    mErrori.Add "Riga " & CStr(i + 1) & " (" & prodotto.Codice & "): " & problema
                ElseIf Contiene(prodotto.Codice) Then
                    mErrori.Add "Riga " & CStr(i + 1) & ": codice " & prodotto.Codice & _
                                " duplicato, riga ignorata"
                Else
                    Aggiungi prodotto
                End If
            End If
        Next i

        Return mProdotti.Count
    End Function

    Public Function CaricaDaFile(ByVal percorso As String) As Long
        Return CaricaDaTesto(Utf8File.Leggi(percorso))
    End Function

    Public Sub SalvaSuFile(ByVal percorso As String)
        Utf8File.Scrivi percorso, TestoCsv()
    End Sub

    ' ------------------------------------------------------------------
    ' Helper privati
    ' ------------------------------------------------------------------

    Private Function Chiave(ByVal codice As String) As String
        Return UCase$(Trim$(codice))
    End Function

    Private Function RigaDaProdotto(ByVal p As Prodotto) As String
        Dim campi(0 To 17) As String

        campi(0) = p.Codice
        campi(1) = p.Denominazione
        campi(2) = p.Ingredienti
        campi(3) = p.AllergeniManuali
        campi(4) = Numero.Formatta(p.PesoNettoGrammi, 1)
        campi(5) = Numero.Formatta(p.PrezzoPezzoEuro, 2)
        campi(6) = Numero.Formatta(p.PrezzoKgEuro, 2)
        campi(7) = CStr(p.ValiditaOre)
        campi(8) = SiNo(p.ScadenzaAFineGiornata)
        campi(9) = Numero.Formatta(p.TemperaturaMin, 1)
        campi(10) = Numero.Formatta(p.TemperaturaMax, 1)
        campi(11) = SiNo(p.PesceCrudo)
        campi(12) = p.SpecieCommerciale
        campi(13) = p.NomeScientifico
        campi(14) = p.MetodoProduzione
        campi(15) = p.ZonaCattura
        campi(16) = p.AttrezzoPesca
        campi(17) = p.Note

        Return CsvUtil.ComponiRiga(campi)
    End Function

    Private Function ProdottoDaCampi(ByRef campi() As String) As Prodotto
        Dim p As Prodotto
        Set p = New Prodotto

        p.Codice = CsvUtil.Campo(campi, 0)
        p.Denominazione = CsvUtil.Campo(campi, 1)
        p.Ingredienti = CsvUtil.Campo(campi, 2)
        p.AllergeniManuali = CsvUtil.Campo(campi, 3)
        p.PesoNettoGrammi = Numero.Interpreta(CsvUtil.Campo(campi, 4, "0"))
        p.PrezzoPezzoEuro = Numero.Interpreta(CsvUtil.Campo(campi, 5, "0"))
        p.PrezzoKgEuro = Numero.Interpreta(CsvUtil.Campo(campi, 6, "0"))
        p.ValiditaOre = CLng(Numero.Interpreta(CsvUtil.Campo(campi, 7, "24")))
        p.ScadenzaAFineGiornata = EVero(CsvUtil.Campo(campi, 8, "NO"))
        p.TemperaturaMin = Numero.Interpreta(CsvUtil.Campo(campi, 9, "0"))
        p.TemperaturaMax = Numero.Interpreta(CsvUtil.Campo(campi, 10, "4"))
        p.PesceCrudo = EVero(CsvUtil.Campo(campi, 11, "NO"))
        p.SpecieCommerciale = CsvUtil.Campo(campi, 12)
        p.NomeScientifico = CsvUtil.Campo(campi, 13)
        p.MetodoProduzione = CsvUtil.Campo(campi, 14)
        p.ZonaCattura = CsvUtil.Campo(campi, 15)
        p.AttrezzoPesca = CsvUtil.Campo(campi, 16)
        p.Note = CsvUtil.Campo(campi, 17)

        Return p
    End Function

    Private Function SiNo(ByVal valore As Boolean) As String
        If valore Then Return "SI"
        Return "NO"
    End Function

    ' Accetta tutte le forme che un operatore o un gestionale potrebbero
    ' scrivere per dire "vero".
    Private Function EVero(ByVal testo As String) As Boolean
        Select Case UCase$(Trim$(testo))
            Case "SI", "SI'", "S", "1", "VERO", "TRUE", "X", "Y", "YES"
                Return True
            Case Else
                Return False
        End Select
    End Function

    Private Function NumeroDiRighe(ByRef righe() As String) As Long
        Dim n As Long

        On Error Resume Next
        n = UBound(righe) - LBound(righe) + 1
        If Err.Number <> 0 Then
            Err.Clear
            n = 0
        End If
        On Error GoTo 0

        If n < 0 Then n = 0
        Return n
    End Function

End Class

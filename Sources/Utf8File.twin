'
' Utf8File - lettura e scrittura di file di testo in UTF-8.
'
' Perche' non Print # e Line Input #: quelle istruzioni scrivono e leggono in
' ANSI, quindi una "a" accentata o il simbolo dell'euro dentro un elenco di
' ingredienti si perdono o diventano un carattere diverso secondo la lingua
' del PC. Qui la conversione e' fatta a mano, byte per byte, senza chiamate
' all'API di Windows: lo stesso sorgente compila e si comporta identico a 32
' e a 64 bit.
'
' I file vengono scritti con il BOM, cosi' Excel apre prodotti.csv con gli
' accenti giusti invece di mostrare caratteri strani.
'
Module Utf8File

    Private Const BOM_0 As Long = &HEF&
    Private Const BOM_1 As Long = &HBB&
    Private Const BOM_2 As Long = &HBF&

    ' ------------------------------------------------------------------
    ' Conversione
    ' ------------------------------------------------------------------

    ' Converte una stringa in una sequenza di byte UTF-8.
    ' Le coppie surrogate vengono ricomposte nel loro carattere a 4 byte.
    Public Function Codifica(ByVal testo As String) As Byte()
        Dim risultato() As Byte
        Dim lunghezza As Long
        Dim conteggio As Long
        Dim i As Long
        Dim codice As Long
        Dim codiceBasso As Long

        lunghezza = Len(testo)
        If lunghezza = 0 Then
            ReDim risultato(0 To 0)
            Return LasciaSoloPrimi(risultato, 0)
        End If

        ' Nel caso peggiore ogni carattere occupa 3 byte; le coppie surrogate
        ' occupano 4 byte ma consumano 2 caratteri, quindi non sforano.
        ReDim risultato(0 To lunghezza * 3)

        i = 1
        Do While i <= lunghezza
            codice = AscW(Mid$(testo, i, 1)) And &HFFFF&

            ' Coppia surrogata: due unita' UTF-16 per un solo carattere.
            If codice >= &HD800& And codice <= &HDBFF& And i < lunghezza Then
                codiceBasso = AscW(Mid$(testo, i + 1, 1)) And &HFFFF&
                If codiceBasso >= &HDC00& And codiceBasso <= &HDFFF& Then
                    codice = &H10000& + ((codice - &HD800&) * &H400&) + _
                             (codiceBasso - &HDC00&)
                    i += 1
                End If
            End If

            If codice < &H80& Then
                risultato(conteggio) = CByte(codice)
                conteggio += 1
            ElseIf codice < &H800& Then
                risultato(conteggio) = CByte(&HC0& Or (codice \ &H40&))
                risultato(conteggio + 1) = CByte(&H80& Or (codice And &H3F&))
                conteggio += 2
            ElseIf codice < &H10000& Then
                risultato(conteggio) = CByte(&HE0& Or (codice \ &H1000&))
                risultato(conteggio + 1) = CByte(&H80& Or ((codice \ &H40&) And &H3F&))
                risultato(conteggio + 2) = CByte(&H80& Or (codice And &H3F&))
                conteggio += 3
            Else
                risultato(conteggio) = CByte(&HF0& Or (codice \ &H40000&))
                risultato(conteggio + 1) = CByte(&H80& Or ((codice \ &H1000&) And &H3F&))
                risultato(conteggio + 2) = CByte(&H80& Or ((codice \ &H40&) And &H3F&))
                risultato(conteggio + 3) = CByte(&H80& Or (codice And &H3F&))
                conteggio += 4
            End If

            i += 1
        Loop

        Return LasciaSoloPrimi(risultato, conteggio)
    End Function

    ' Converte una sequenza di byte UTF-8 in stringa. Il BOM iniziale, se
    ' c'e', viene scartato. I byte non validi diventano il carattere di
    ' sostituzione U+FFFD invece di far fallire la lettura: un file sporco
    ' va comunque aperto, l'operatore deve poter vedere cosa contiene.
    Public Function Decodifica(ByRef byt() As Byte) As String
        Dim risultato As String
        Dim i As Long
        Dim ultimo As Long
        Dim primo As Long
        Dim b As Long
        Dim codice As Long
        Dim continuazioni As Long
        Dim k As Long
        Dim valido As Boolean

        On Error Resume Next
        primo = LBound(byt)
        ultimo = UBound(byt)
        If Err.Number <> 0 Then
            Err.Clear
            Return ""
        End If
        On Error GoTo 0

        i = primo

        ' Salta il BOM.
        If ultimo - primo >= 2 Then
            If byt(primo) = BOM_0 And byt(primo + 1) = BOM_1 And byt(primo + 2) = BOM_2 Then
                i = primo + 3
            End If
        End If

        Do While i <= ultimo
            b = byt(i)

            If b < &H80& Then
                codice = b
                continuazioni = 0
            ElseIf (b And &HE0&) = &HC0& Then
                codice = b And &H1F&
                continuazioni = 1
            ElseIf (b And &HF0&) = &HE0& Then
                codice = b And &HF&
                continuazioni = 2
            ElseIf (b And &HF8&) = &HF0& Then
                codice = b And &H7&
                continuazioni = 3
            Else
                risultato = risultato & ChrW$(&HFFFD&)
                i += 1
                Continue Do
            End If

            ' Tutti i byte di continuazione devono esserci e iniziare con 10.
            valido = True
            If i + continuazioni > ultimo Then
                valido = False
            Else
                For k = 1 To continuazioni
                    If (byt(i + k) And &HC0&) <> &H80& Then
                        valido = False
                        Exit For
                    End If
                    codice = (codice * &H40&) Or (byt(i + k) And &H3F&)
                Next k
            End If

            If Not valido Then
                risultato = risultato & ChrW$(&HFFFD&)
                i += 1
                Continue Do
            End If

            If codice > &HFFFF& Then
                ' Fuori dal piano base: serve una coppia surrogata.
                codice = codice - &H10000&
                risultato = risultato & ChrW$(&HD800& + (codice \ &H400&)) & _
                                        ChrW$(&HDC00& + (codice And &H3FF&))
            Else
                risultato = risultato & ChrW$(codice)
            End If

            i += continuazioni + 1
        Loop

        Return risultato
    End Function

    ' ------------------------------------------------------------------
    ' File
    ' ------------------------------------------------------------------

    Public Function Esiste(ByVal percorso As String) As Boolean
        If Len(percorso) = 0 Then Return False
        Return (Len(Dir$(percorso)) > 0)
    End Function

    ' Legge tutto il file come testo. Un file assente solleva l'errore 53.
    Public Function Leggi(ByVal percorso As String) As String
        Dim canale As Integer
        Dim byt() As Byte
        Dim lunghezza As Long

        If Not Esiste(percorso) Then
            Err.Raise 53, "Utf8File.Leggi", "File non trovato: " & percorso
        End If

        canale = FreeFile
        Open percorso For Binary Access Read As #canale
        lunghezza = LOF(canale)
        If lunghezza > 0 Then
            ReDim byt(0 To lunghezza - 1)
            Get #canale, 1, byt
        End If
        Close #canale

        If lunghezza = 0 Then Return ""
        Return Decodifica(byt)
    End Function

    ' Scrive tutto il file. Il file precedente viene rimosso prima, perche'
    ' "Open For Binary" non accorcia un file che era piu' lungo e lascerebbe
    ' in coda pezzi del contenuto vecchio.
    Public Sub Scrivi(ByVal percorso As String, ByVal testo As String, _
                      Optional ByVal conBom As Boolean = True)
        Dim canale As Integer
        Dim byt() As Byte
        Dim bom(0 To 2) As Byte

        If Esiste(percorso) Then Kill percorso

        canale = FreeFile
        Open percorso For Binary Access Write As #canale

        If conBom Then
            bom(0) = CByte(BOM_0)
            bom(1) = CByte(BOM_1)
            bom(2) = CByte(BOM_2)
            Put #canale, , bom
        End If

        byt = Codifica(testo)
        If NumeroDiByte(byt) > 0 Then Put #canale, , byt

        Close #canale
    End Sub

    ' Aggiunge testo alla fine del file, creandolo se non c'e'. Serve ai
    ' file di registro, che crescono una riga per volta: riscrivere tutto il
    ' file a ogni etichetta stampata diventerebbe lento e, se il PC si
    ' spegne a meta', perderebbe il registro intero invece di una riga.
    Public Sub Accoda(ByVal percorso As String, ByVal testo As String)
        Dim canale As Integer
        Dim byt() As Byte

        If Len(testo) = 0 Then Exit Sub

        If Not Esiste(percorso) Then
            Scrivi percorso, testo
            Exit Sub
        End If

        byt = Codifica(testo)
        If NumeroDiByte(byt) = 0 Then Exit Sub

        canale = FreeFile
        Open percorso For Binary Access Write As #canale
        Put #canale, LOF(canale) + 1, byt
        Close #canale
    End Sub

    ' ------------------------------------------------------------------
    ' Helper privati
    ' ------------------------------------------------------------------

    ' Accorcia l'array ai primi n byte. Con n = 0 restituisce un array vuoto,
    ' cioe' con UBound minore di LBound.
    Private Function LasciaSoloPrimi(ByRef byt() As Byte, ByVal n As Long) As Byte()
        Dim vuoto() As Byte

        If n <= 0 Then Return vuoto
        ReDim Preserve byt(0 To n - 1)
        Return byt
    End Function

    ' Conta i byte di un array che puo' anche non essere mai stato
    ' dimensionato: in quel caso UBound solleva un errore.
    Public Function NumeroDiByte(ByRef byt() As Byte) As Long
        Dim n As Long

        On Error Resume Next
        n = UBound(byt) - LBound(byt) + 1
        If Err.Number <> 0 Then
            Err.Clear
            n = 0
        End If
        On Error GoTo 0

        If n < 0 Then n = 0
        Return n
    End Function

End Module

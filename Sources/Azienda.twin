'
' Azienda - i dati del negozio e il formato dell'etichetta.
'
' Sono le cose che non cambiano da un'etichetta all'altra: ragione sociale,
' indirizzo, marchio di identificazione, misure del supporto, preferenze sul
' codice a barre. Stanno in un file di testo con righe "chiave = valore",
' perche' un formato leggibile si corregge con il Blocco note anche quando il
' programma non parte.
'
' Le righe che iniziano con il cancelletto sono commenti e vengono scartate
' in lettura da CsvUtil.SpezzaRighe.
'
Class Azienda

    ' --- Identificazione dell'operatore ---------------------------------
    Public RagioneSociale As String
    Public Indirizzo As String
    Public Cap As String
    Public Citta As String
    Public Provincia As String
    Public PartitaIva As String
    Public MarchioIdentificazione As String   ' il bollo CE, es. "IT 1234 CE"
    Public Telefono As String

    ' --- Formato del supporto, in millimetri ----------------------------
    Public LarghezzaMm As Double
    Public AltezzaMm As Double
    Public MargineMm As Double

    ' --- Lotto -----------------------------------------------------------
    Public PrefissoLotto As String
    Public FormatoCodiceLotto As Lotto.FormatoLotto

    ' --- Codice a barre --------------------------------------------------
    Public MostraBarcode As Boolean
    Public BarcodeIncludeDataProduzione As Boolean
    Public ModuloBarcodeMinimoMm As Double     ' sotto questa misura non si legge

    ' --- Testi fissi -----------------------------------------------------
    Public AvvisoAbbattimento As String
    Public NomeFont As String

    Private Sub Class_Initialize()
        ' Un formato da 70 x 50 mm sta su quasi tutte le stampanti termiche e
        ' lascia spazio all'elenco ingredienti, che e' la parte piu' lunga.
        LarghezzaMm = 70
        AltezzaMm = 50
        MargineMm = 2

        PrefissoLotto = Lotto.PREFISSO_PREDEFINITO
        FormatoCodiceLotto = Lotto.lfCompatto

        MostraBarcode = True
        BarcodeIncludeDataProduzione = False
        ModuloBarcodeMinimoMm = 0.19          ' circa 1,5 punti a 203 dpi

        ' Testo breve, perche' su un'etichetta da 70 mm la formula completa
        ' occuperebbe quattro righe. La dicitura estesa e' nel file di
        ' esempio Dati/azienda.ini, da incollare qui se il supporto e' piu'
        ' grande o se lo chiede l'ASL.
        AvvisoAbbattimento = "Prodotto a base di pesce consumato crudo, " & _
                             "sottoposto a bonifica preventiva ai sensi del " & _
                             "Reg. CE 853/2004."

        NomeFont = "Arial"
    End Sub

    ' ------------------------------------------------------------------
    ' Logica
    ' ------------------------------------------------------------------

    ' "Via Roma 1 - 20100 Milano (MI)", saltando i pezzi non compilati.
    Public Function IndirizzoCompleto() As String
        Dim risultato As String
        Dim localita As String

        risultato = Trim$(Indirizzo)

        localita = Trim$(Cap & " " & Citta)
        If Len(Trim$(Provincia)) > 0 Then
            localita = Trim$(localita & " (" & Trim$(Provincia) & ")")
        End If

        If Len(risultato) > 0 And Len(localita) > 0 Then
            Return risultato & " - " & localita
        End If
        If Len(localita) > 0 Then Return localita
        Return risultato
    End Function

    ' La riga del produttore in fondo all'etichetta: ragione sociale,
    ' indirizzo e marchio di identificazione.
    Public Function RigaProduttore() As String
        Dim risultato As String

        risultato = Trim$(RagioneSociale)
        If Len(IndirizzoCompleto()) > 0 Then
            risultato = Trim$(risultato & " - " & IndirizzoCompleto())
        End If
        If Len(Trim$(MarchioIdentificazione)) > 0 Then
            risultato = Trim$(risultato & " - " & Trim$(MarchioIdentificazione))
        End If
        Return risultato
    End Function

    ' Larghezza utile fra i due margini.
    Public Function LarghezzaUtileMm() As Double
        Return LarghezzaMm - 2 * MargineMm
    End Function

    Public Function AltezzaUtileMm() As Double
        Return AltezzaMm - 2 * MargineMm
    End Function

    ' Descrizione del primo problema, stringa vuota se va tutto bene.
    Public Function Valida() As String
        If Len(Trim$(RagioneSociale)) = 0 Then
            Return "La ragione sociale e' obbligatoria in etichetta."
        End If
        If Len(IndirizzoCompleto()) = 0 Then
            Return "L'indirizzo dell'operatore e' obbligatorio in etichetta."
        End If
        If LarghezzaMm < 20 Or AltezzaMm < 15 Then
            Return "Il formato dell'etichetta e' troppo piccolo."
        End If
        If MargineMm < 0 Then Return "Il margine non puo' essere negativo."
        If LarghezzaUtileMm() < 10 Or AltezzaUtileMm() < 10 Then
            Return "Il margine non lascia spazio al contenuto."
        End If
        Return ""
    End Function

    ' ------------------------------------------------------------------
    ' File
    ' ------------------------------------------------------------------

    Public Function TestoImpostazioni() As String
        Dim r As String

        r = "# Dati del negozio e formato dell'etichetta." & vbCrLf
        r = r & "# Le righe che iniziano con # sono commenti." & vbCrLf & vbCrLf

        r = r & "RagioneSociale = " & RagioneSociale & vbCrLf
        r = r & "Indirizzo = " & Indirizzo & vbCrLf
        r = r & "Cap = " & Cap & vbCrLf
        r = r & "Citta = " & Citta & vbCrLf
        r = r & "Provincia = " & Provincia & vbCrLf
        r = r & "PartitaIva = " & PartitaIva & vbCrLf
        r = r & "MarchioIdentificazione = " & MarchioIdentificazione & vbCrLf
        r = r & "Telefono = " & Telefono & vbCrLf & vbCrLf

        r = r & "LarghezzaMm = " & Numero.Formatta(LarghezzaMm, 1) & vbCrLf
        r = r & "AltezzaMm = " & Numero.Formatta(AltezzaMm, 1) & vbCrLf
        r = r & "MargineMm = " & Numero.Formatta(MargineMm, 1) & vbCrLf & vbCrLf

        r = r & "PrefissoLotto = " & PrefissoLotto & vbCrLf
        r = r & "FormatoLotto = " & NomeFormatoLotto() & vbCrLf & vbCrLf

        r = r & "MostraBarcode = " & SiNo(MostraBarcode) & vbCrLf
        r = r & "BarcodeIncludeDataProduzione = " & _
                SiNo(BarcodeIncludeDataProduzione) & vbCrLf
        r = r & "ModuloBarcodeMinimoMm = " & _
                Numero.Formatta(ModuloBarcodeMinimoMm, 2) & vbCrLf & vbCrLf

        r = r & "NomeFont = " & NomeFont & vbCrLf
        r = r & "AvvisoAbbattimento = " & AvvisoAbbattimento & vbCrLf

        Return r
    End Function

    Public Sub CaricaDaTesto(ByVal testo As String)
        Dim righe() As String
        Dim i As Long
        Dim riga As String
        Dim posizione As Long
        Dim chiave As String
        Dim valore As String

        righe = CsvUtil.SpezzaRighe(testo)

        On Error Resume Next
        If UBound(righe) < LBound(righe) Then
            Err.Clear
            Exit Sub
        End If
        If Err.Number <> 0 Then
            Err.Clear
            Exit Sub
        End If
        On Error GoTo 0

        For i = LBound(righe) To UBound(righe)
            riga = righe(i)
            posizione = InStr(riga, "=")
            If posizione > 1 Then
                chiave = UCase$(Trim$(Left$(riga, posizione - 1)))
                valore = Trim$(Mid$(riga, posizione + 1))
                ApplicaValore chiave, valore
            End If
        Next i
    End Sub

    Public Sub CaricaDaFile(ByVal percorso As String)
        CaricaDaTesto Utf8File.Leggi(percorso)
    End Sub

    Public Sub SalvaSuFile(ByVal percorso As String)
        Utf8File.Scrivi percorso, TestoImpostazioni()
    End Sub

    ' ------------------------------------------------------------------
    ' Helper privati
    ' ------------------------------------------------------------------

    ' Una chiave sconosciuta viene ignorata invece di far fallire il
    ' caricamento: un file scritto da una versione futura deve comunque
    ' aprirsi con quello che questa versione sa leggere.
    Private Sub ApplicaValore(ByVal chiave As String, ByVal valore As String)
        Select Case chiave
            Case "RAGIONESOCIALE":          RagioneSociale = valore
            Case "INDIRIZZO":               Indirizzo = valore
            Case "CAP":                     Cap = valore
            Case "CITTA":                   Citta = valore
            Case "PROVINCIA":               Provincia = valore
            Case "PARTITAIVA":              PartitaIva = valore
            Case "MARCHIOIDENTIFICAZIONE":  MarchioIdentificazione = valore
            Case "TELEFONO":                Telefono = valore

            Case "LARGHEZZAMM":             LarghezzaMm = Numero.Interpreta(valore)
            Case "ALTEZZAMM":               AltezzaMm = Numero.Interpreta(valore)
            Case "MARGINEMM":               MargineMm = Numero.Interpreta(valore)

            Case "PREFISSOLOTTO":           PrefissoLotto = valore
            Case "FORMATOLOTTO"
                If UCase$(valore) = "GIULIANO" Then
                    FormatoCodiceLotto = Lotto.lfGiuliano
                Else
                    FormatoCodiceLotto = Lotto.lfCompatto
                End If

            Case "MOSTRABARCODE":           MostraBarcode = EVero(valore)
            Case "BARCODEINCLUDEDATAPRODUZIONE"
                BarcodeIncludeDataProduzione = EVero(valore)
            Case "MODULOBARCODEMINIMOMM"
                ModuloBarcodeMinimoMm = Numero.Interpreta(valore)

            Case "NOMEFONT":                NomeFont = valore
            Case "AVVISOABBATTIMENTO":      AvvisoAbbattimento = valore
        End Select
    End Sub

    Private Function NomeFormatoLotto() As String
        If FormatoCodiceLotto = Lotto.lfGiuliano Then Return "Giuliano"
        Return "Compatto"
    End Function

    Private Function SiNo(ByVal valore As Boolean) As String
        If valore Then Return "SI"
        Return "NO"
    End Function

    Private Function EVero(ByVal testo As String) As Boolean
        Select Case UCase$(Trim$(testo))
            Case "SI", "SI'", "S", "1", "VERO", "TRUE", "X", "Y", "YES"
                Return True
            Case Else
                Return False
        End Select
    End Function

End Class

'
' DateUtil - formattazione e aritmetica delle date per le etichette.
'
' Tutte le funzioni formattano a mano, cifra per cifra, senza passare da
' Format$: il formato di un'etichetta alimentare non deve cambiare se cambia
' la lingua di Windows o le impostazioni internazionali del PC del negozio.
'
' Le date sono sempre nel formato italiano gg/mm/aaaa. Il formato aammgg
' serve solo dentro i codici a barre GS1, dove e' lo standard.
'
Module DateUtil

    ' Numero su due cifre, con lo zero davanti: 5 -> "05".
    Public Function DueCifre(ByVal n As Long) As String
        If n < 0 Then
            Err.Raise 5, "DateUtil.DueCifre", "n deve essere >= 0"
        End If
        If n < 10 Then Return "0" & CStr(n)
        Return CStr(n)
    End Function

    ' gg/mm/aaaa
    Public Function FormattaData(ByVal d As Date) As String
        Return DueCifre(Day(d)) & "/" & DueCifre(Month(d)) & "/" & CStr(Year(d))
    End Function

    ' gg/mm/aa, per le etichette piccole dove lo spazio e' poco.
    Public Function FormattaDataBreve(ByVal d As Date) As String
        Return DueCifre(Day(d)) & "/" & DueCifre(Month(d)) & "/" & _
               DueCifre(Year(d) Mod 100)
    End Function

    ' HH:MM in formato 24 ore.
    Public Function FormattaOra(ByVal d As Date) As String
        Return DueCifre(Hour(d)) & ":" & DueCifre(Minute(d))
    End Function

    ' gg/mm/aaaa HH:MM
    Public Function FormattaDataOra(ByVal d As Date) As String
        Return FormattaData(d) & " " & FormattaOra(d)
    End Function

    ' aammgg: il formato che gli identificatori GS1 11, 13, 15 e 17 pretendono
    ' dentro un codice a barre.
    Public Function FormattaAaMmGg(ByVal d As Date) As String
        Return DueCifre(Year(d) Mod 100) & DueCifre(Month(d)) & DueCifre(Day(d))
    End Function

    ' Azzera l'ora e tiene solo il giorno. Passa da DateSerial invece di Int()
    ' perche' Int() su una data con ora tronca verso lo zero, non verso il
    ' giorno, e sulle date prima del 1900 sbaglia di un giorno.
    Public Function SoloData(ByVal d As Date) As Date
        Return DateSerial(Year(d), Month(d), Day(d))
    End Function

    ' Aggiunge ore a una data e ora. Passa da DateAdd invece di sommare
    ' ore/24, che accumula errore in virgola mobile e puo' spostare la
    ' scadenza di un minuto.
    Public Function AggiungiOre(ByVal d As Date, ByVal ore As Long) As Date
        Return DateAdd("h", ore, d)
    End Function

    Public Function AggiungiGiorni(ByVal d As Date, ByVal giorni As Long) As Date
        Return DateAdd("d", giorni, d)
    End Function

    ' Ultimo istante utile del giorno: 23:59. Serve quando la scadenza e'
    ' espressa in giorni e non in ore, perche' un prodotto che scade "fra tre
    ' giorni" scade alla fine del terzo giorno, non all'ora di produzione.
    Public Function FineGiornata(ByVal d As Date) As Date
        Return DateSerial(Year(d), Month(d), Day(d)) + TimeSerial(23, 59, 0)
    End Function

    ' Giorno dell'anno, da 1 a 366. Molti lotti alimentari usano anno + giorno
    ' giuliano invece della data completa.
    Public Function GiornoDellAnno(ByVal d As Date) As Long
        Return DateDiff("d", DateSerial(Year(d), 1, 1), SoloData(d)) + 1
    End Function

End Module

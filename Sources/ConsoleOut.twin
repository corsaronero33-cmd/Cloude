'
' ConsoleOut - output di testo che funziona sia dentro l'IDE sia da console.
'
' Ogni riga finisce sempre nella finestra Debug dell'IDE. Se il processo ha
' anche uno stdout collegato (compilazione come applicazione console, oppure
' avvio da cmd.exe) la stessa riga viene scritta li' in Unicode.
'
' Le Declare usano PtrSafe e LongPtr, quindi lo stesso sorgente compila sia
' a 32 sia a 64 bit.
'
Module ConsoleOut

    Private Declare PtrSafe Function GetStdHandle Lib "kernel32" ( _
        ByVal nStdHandle As Long) As LongPtr

    Private Declare PtrSafe Function WriteConsoleW Lib "kernel32" ( _
        ByVal hConsoleOutput As LongPtr, _
        ByVal lpBuffer As LongPtr, _
        ByVal nNumberOfCharsToWrite As Long, _
        ByRef lpNumberOfCharsWritten As Long, _
        ByVal lpReserved As LongPtr) As Long

    Private Const STD_OUTPUT_HANDLE As Long = -11&
    Private Const INVALID_HANDLE_VALUE As LongPtr = -1

    ' Scrive una riga di testo seguita da un a capo.
    Public Sub WriteLine(Optional ByVal text As String = "")
        Debug.Print text
        WriteToStdOut text & vbCrLf
    End Sub

    ' Scrive una riga in forma di titolo, sottolineata con dei trattini.
    Public Sub WriteHeading(ByVal text As String)
        WriteLine text
        WriteLine StringUtils.Repeat("-", Len(text))
    End Sub

    ' Scrive due colonne allineate: etichetta a sinistra, valore a destra.
    Public Sub WriteField(ByVal label As String, ByVal value As String, _
                          Optional ByVal labelWidth As Long = 22)
        WriteLine StringUtils.PadRight(label, labelWidth, ".") & " " & value
    End Sub

    ' Invia il testo a stdout, se esiste. Un handle assente non e' un errore:
    ' dentro l'IDE Debug.Print ha gia' fatto il suo lavoro.
    Private Sub WriteToStdOut(ByVal text As String)
        Dim handle As LongPtr
        Dim charsWritten As Long

        If Len(text) = 0 Then Exit Sub

        handle = GetStdHandle(STD_OUTPUT_HANDLE)
        If handle = 0 Then Exit Sub
        If handle = INVALID_HANDLE_VALUE Then Exit Sub

        WriteConsoleW handle, StrPtr(text), Len(text), charsWritten, 0
    End Sub

End Module
